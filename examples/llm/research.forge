#! boundary: server

use
  llm.reason
  web.search

flow research
  needs topic: Text
  gives Text

  stage gather_web
    result = search topic

  stage gather_papers
    result = search "{topic} academic paper"

  stage gather_news
    result = search "{topic} latest news"

  stage synthesize
    needs gather_web.result, gather_papers.result, gather_news.result
    draft = reason "synthesize into a brief report: {gather_web.result} {gather_papers.result} {gather_news.result}"

  stage verify
    needs synthesize.draft
    checked = reason "is this factually consistent? if not, correct it: {synthesize.draft}"
    when checked.sure -> give checked
    when checked.unsure -> give checked
    else -> give "Could not verify report."

fn main
  result = research("artificial intelligence")
  say result

#! boundary: server

# ================================================================
# Approval Gate — live E2E server
# ================================================================
# Run from repo root (run alongside slack-adapter so PostApproval is
# delivered end-to-end to Slack):
#   cargo run -- serve --manifest examples/agents/approval-gate/forge.project.toml \
#     examples/agents/approval-gate/server.forge \
#     --source examples/agents/slack-adapter/main.forge --port 3210
#
# Test flow:
#   1. POST /trigger?context=Deploy+v2&request_id=req-001&callback_url=<ngrok>/webhook/approval&channel=C0123456789
#      → triggers agent
#   2. Agent transitions to waiting_approval and emits PostApproval
#   3. slack-adapter posts Slack message with Approve/Reject buttons
#   4. User clicks Approve/Reject in Slack → Slack POSTs to /webhook/approval
#   5. Agent receives ApprovalResponse, logs decision, transitions to idle
#   6. GET /health → "ok"
#
# Prerequisites:
#   - SLACK_BOT_TOKEN env var set
#   - Bot invited to approval channel
#   - Slack app Interactivity URL set to <ngrok>/webhook/approval
# ================================================================

# ── Events ─────────────────────────────────────────────────────

event TriggerApproval
  context: Text
  request_id: Text
  callback_url: Text
  channel: Text

event ApprovalRequest
  agent_id: Text
  context: Text
  request_id: Text

event ApprovalResponse
  request_id: Text
  approved: Bool
  comment: Text

# Slack-adapter outbound event (shape must match slack-adapter/main.forge).
event PostApproval
  channel: Text
  title: Text
  context: Text
  callback_url: Text
  request_id: Text
  thread_ts: Text

# ── States ─────────────────────────────────────────────────────

states ApprovalPhase
  idle -> waiting_approval
  waiting_approval -> idle

# ── Agent ──────────────────────────────────────────────────────

agent approval_gate
  lifecycle: ApprovalPhase
  memory
    request_id: Text
    context: Text
    decision: Text
    channel: Text
  subscribe TriggerApproval
  subscribe ApprovalResponse

  on start
    memory.request_id = ""
    memory.context = ""
    memory.decision = "none"
    memory.channel = ""
    say "[gate] Agent started. Waiting for trigger."

  on TriggerApproval(context: Text, request_id: Text, callback_url: Text, channel: Text)
    requires lifecycle == idle on fail: give "approval already pending"
    memory.context = context
    memory.request_id = request_id
    memory.decision = "pending"
    memory.channel = channel
    transition to waiting_approval
    emit PostApproval(channel: channel, title: "Approval needed", context: context, callback_url: callback_url, request_id: request_id, thread_ts: "")
    say "[gate] Approval request emitted for {request_id}"
    emit ApprovalRequest(agent_id: "approval_gate", context: context, request_id: request_id)
    say "[gate] State: waiting_approval. Listening for ApprovalResponse..."

  on ApprovalResponse(request_id: Text, approved: Bool, comment: Text)
    requires lifecycle == waiting_approval on fail: give "no pending approval"
    requires request_id == memory.request_id on fail: give "stale response"
    if approved
      memory.decision = "approved"
      say "[gate] APPROVED by {comment}"
    if not approved
      memory.decision = "rejected"
      say "[gate] REJECTED by {comment}"
    transition to idle
    say "[gate] Back to idle. Decision: {memory.decision}"

  if stuck for 3 turns
    escalate to human

# ── Warden ─────────────────────────────────────────────────────

warden gate_warden
  manages [approval_gate]
  on stuck: nudge, self
    after 3: escalate
  on timeout: restart, self
  on crash: restart, self
  on hallucination: restart, self
  on contradiction: nudge, self
    after 2: escalate
  on budget: nudge, self
    after 1: escalate
  max_retries 3 per 1h then escalate

# ── System ─────────────────────────────────────────────────────

system approval_system
  use
    gate: approval_gate

# ── Endpoints ──────────────────────────────────────────────────

endpoint health() -> Text
  give "ok"

endpoint trigger(context: Text, request_id: Text, callback_url: Text, channel: Text) -> Text
  emit TriggerApproval(context: context, request_id: request_id, callback_url: callback_url, channel: channel)
  give "triggered: {request_id}"

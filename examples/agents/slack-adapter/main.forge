#! boundary: server

# ================================================================
# Slack Adapter — Standalone Runner
# ================================================================
# Part of the clone-developer track (#292), issue #298 (T3.1).
# Refactored by #356 (T8.1): agent/events/templates extracted into
# agents.forge so workflows/clone-dev/ can source them without
# forking. This file now only wraps them with a warden, a system,
# and a health endpoint so the adapter can still run standalone.
#
# Run:
#   SLACK_BOT_TOKEN=xoxb-... cargo run -- serve \
#     --manifest examples/agents/slack-adapter/forge.project.toml \
#     examples/agents/slack-adapter/main.forge --port 3212
# ================================================================

# ── Warden ─────────────────────────────────────────────────────

warden slack_warden
  manages [slack_adapter]
  on stuck: nudge, self
    after 3: escalate
  on timeout: restart, self
  on crash: restart, self
  on hallucination: nudge, self
    after 2: escalate
  on contradiction: nudge, self
    after 2: escalate
  on budget: nudge, self
    after 1: escalate
  max_retries 3 per 1h then escalate

# ── System ─────────────────────────────────────────────────────

system slack_adapter_system
  use
    slack: slack_adapter

# ── Endpoints ──────────────────────────────────────────────────

endpoint health() -> Text
  give "ok"

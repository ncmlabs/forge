#! boundary: server

# ================================================================
# Clone-dev walking skeleton — T1.1 (issue #293)
# ================================================================
# Proves the 3-hop topology runs end-to-end with zero new runtime
# primitives:
#
#     POST /clone_dev                                    (endpoint)
#         │ emit ClonedevTaskInbound(kind, ...)
#         ▼
#     mastermind                                         (agent #1)
#         │ reason + pattern-match on kind → target_agent
#         │ assign task_id, append to task_graph
#         │ emit TaskRouted(task_id, target_agent, kind, ...)
#         ▼
#     ┌─────────────────────────────┬──────────────────────────┐
#     │ pr_reviewer                 │ echo_specialist          │
#     │ subscribe where             │ subscribe where          │
#     │   target_agent=="pr_reviewer" │ target_agent=="echo"   │
#     │ → github.get_pr/check_ci    │ → slack.send_message     │
#     │ → reason summary            │                          │
#     │ → slack.send_approval       │                          │
#     └─────────────────────────────┴──────────────────────────┘
#
# One `org_warden` supervises all three. Observer shows the 3-hop
# trace automatically via `event_emit`/`event_delivered` SSE.
#
# Fork history: forked from examples/agents/pr-review-bot/server.forge.
# The pr_reviewer body is kept largely intact — only the subscription
# and field-unpacking changed so it consumes TaskRouted instead of
# ReviewPRRequested.
#
# Run:
#   FORGE_CONFIG=forge.config.toml SLACK_BOT_TOKEN=xoxb-... \
#   ANTHROPIC_API_KEY=... \
#   cargo run -- serve \
#     --manifest examples/agents/clone-dev-skeleton/forge.project.toml \
#     examples/agents/clone-dev-skeleton/main.forge --port 3211
#
# Acceptance (see README.md):
#   curl -X POST http://localhost:3211/clone_dev -d 'kind=pr_review' ...
#   curl -X POST http://localhost:3211/clone_dev -d 'kind=echo' ...
#   curl -X POST http://localhost:3211/__forge/inject/stuck \
#        -d '{"agent":"echo_specialist"}'    # x4 → escalation
# ================================================================

use
  llm.reason
  skill.slack
  skill.github

# ── Types ──────────────────────────────────────────────────────
# T4.1 (#299): record type for task-graph nodes. Replaces the flat
# pipe-delimited `Text[]` with a typed DAG node so mastermind can
# reason about `blocked_on` relations and detect cycles.
type TaskNode
  task_id: Text
  status: Text
  blocked_on: Text[]
  specialist: Text
  project: Text

# ── Events ─────────────────────────────────────────────────────

# Fan-in from HTTP endpoint. All kind-specific fields travel flat;
# specialists read only the ones they care about (see plan §event shape).
event ClonedevTaskInbound
  kind: Text
  repo: Text
  pr_number: Text
  callback_url: Text
  channel: Text
  message: Text

# Mastermind → specialist routing. Specialists filter with
# `where target_agent == "<self>"`.
event TaskRouted
  task_id: Text
  target_agent: Text
  kind: Text
  summary: Text
  repo: Text
  pr_number: Text
  callback_url: Text
  channel: Text
  message: Text

# Reused from approval-gate / pr-review-bot — emitted by the built-in
# /webhook/approval handler when a Slack button is clicked.
event ApprovalResponse
  request_id: Text
  approved: Bool
  comment: Text

# ── T4.1 (#299): task-graph events ─────────────────────────────
# TaskBlocked: posted by a specialist, a cross-project router, or
# the /task_blocked smoke endpoint. mastermind cycle-checks, then
# either records the relation or emits CycleDetected and escalates.
event TaskBlocked
  task_id: Text
  blocked_on: Text[]

# Terminal signal for a task. T4.2 / release_manager will emit on
# PR merge. /task_completed drives it in smoke tests. Field name
# matches workflows/dev-cycle/main.forge:131 for future parity.
event TaskCompleted
  task_id: Text

# Fanout: a completion freed a dependent.
event UnblockTask
  task_id: Text
  unblocked_by: Text

# Refusal: proposed blocker would close a loop in the graph.
event CycleDetected
  task_id: Text
  blocker_id: Text
  note: Text

# ── States ─────────────────────────────────────────────────────

states ReviewPhase
  idle -> awaiting_approval
  awaiting_approval -> idle

# ── Pure tasks ─────────────────────────────────────────────────
# T4.1 (#299): task-graph helpers. Each function stays within
# FORGE's i3-to-i4 nesting limit by fanning out to narrow helpers,
# mirroring the SwarmMastery pattern (dev-cycle/main.forge:305-342).
# Cycle detection is intentionally shallow (1-hop) per the DoD's
# "simple cycle detection"; deeper wedges are caught by the
# warden's escalate-after-3 policy.

pure text_in_list
  needs items: Text[], target: Text
  gives Bool
  do
    for item in items
      if item == target
        give true
    give false

pure get_task_blockers
  needs graph: TaskNode[], task_id: Text
  gives Text[]
  do
    for node in graph
      if node.task_id == task_id
        give node.blocked_on
    give []

# Returns true iff adding `dependent_id --blocked_on--> blocker_id`
# closes a 1-hop cycle, i.e. blocker_id already blocks on dependent_id.
pure would_create_cycle
  needs graph: TaskNode[], dependent_id: Text, blocker_id: Text
  gives Bool
  do
    blocker_blockers = get_task_blockers(graph, blocker_id)
    give text_in_list(blocker_blockers, dependent_id)

# Walks the proposed blockers; returns the first one that would
# cycle, or empty string if none.
pure first_cycling_blocker
  needs graph: TaskNode[], dependent_id: Text, candidates: Text[]
  gives Text
  do
    for candidate in candidates
      would_loop = would_create_cycle(graph, dependent_id, candidate)
      if would_loop
        give candidate
    give ""

pure keep_unless_match
  needs id: Text, target: Text
  gives Text[]
  do
    if id == target
      give []
    give [id]

pure remove_id
  needs ids: Text[], target: Text
  gives Text[]
  do
    result = []
    for id in ids
      kept = keep_unless_match(id, target)
      result = result + kept
    give result

pure status_for_blockers
  needs blockers: Text[]
  gives Text
  do
    if blockers.length == 0
      give "in_flight"
    give "blocked"

# Returns true iff completing completed_id would fully unblock this
# node (was a blocker, and it was the last remaining one).
pure becomes_unblocked
  needs node: TaskNode, completed_id: Text
  gives Bool
  do
    had_blocker = text_in_list(node.blocked_on, completed_id)
    if had_blocker
      new_blockers = remove_id(node.blocked_on, completed_id)
      give new_blockers.length == 0
    give false

pure find_newly_unblocked
  needs graph: TaskNode[], completed_id: Text
  gives Text[]
  do
    result = []
    for node in graph
      freed = becomes_unblocked(node, completed_id)
      if freed
        result = result + [node.task_id]
    give result

pure maybe_patch_node
  needs node: TaskNode, target_id: Text, new_status: Text, new_blocked_on: Text[]
  gives TaskNode
  do
    if node.task_id == target_id
      give TaskNode(task_id: node.task_id, status: new_status, blocked_on: new_blocked_on, specialist: node.specialist, project: node.project)
    give node

pure update_task_node
  needs graph: TaskNode[], task_id: Text, new_status: Text, new_blocked_on: Text[]
  gives TaskNode[]
  do
    result = []
    for node in graph
      patched = maybe_patch_node(node, task_id, new_status, new_blocked_on)
      result = result + [patched]
    give result

# For the completed_id node: flip status to "done".
# For each other node that was blocked_on completed_id: drop the
# blocker and recompute status ("in_flight" if free, else "blocked").
pure propagate_completion
  needs node: TaskNode, completed_id: Text
  gives TaskNode
  do
    if node.task_id == completed_id
      give TaskNode(task_id: node.task_id, status: "done", blocked_on: node.blocked_on, specialist: node.specialist, project: node.project)
    had_blocker = text_in_list(node.blocked_on, completed_id)
    if had_blocker
      new_blockers = remove_id(node.blocked_on, completed_id)
      new_status = status_for_blockers(new_blockers)
      give TaskNode(task_id: node.task_id, status: new_status, blocked_on: new_blockers, specialist: node.specialist, project: node.project)
    give node

pure apply_completion
  needs graph: TaskNode[], completed_id: Text
  gives TaskNode[]
  do
    result = []
    for node in graph
      patched = propagate_completion(node, completed_id)
      result = result + [patched]
    give result

# ── Agent: mastermind ──────────────────────────────────────────
# Classifies inbound tasks and routes to a specialist. Holds the
# task_graph in memory so T4.1 can extend it with blocked_on relations.

agent mastermind
  memory persistent
    task_counter: Number
    task_graph: TaskNode[]
    last_target: Text
    last_decision: Text
  subscribe ClonedevTaskInbound
  subscribe SeedTask
  subscribe TaskBlocked
  subscribe TaskCompleted

  on start
    memory.task_counter = 0
    memory.last_target = "none"
    memory.last_decision = "none"
    say "[mastermind] ready — routing to pr_reviewer or echo_specialist"

  on ClonedevTaskInbound(kind: Text, repo: Text, pr_number: Text, callback_url: Text, channel: Text, message: Text)
    memory.task_counter = memory.task_counter + 1
    task_id = "T{memory.task_counter}"
    decision = reason "Classify clone-dev request. kind is {kind}. Valid targets are pr_reviewer or echo. Reply with target only."
    memory.last_decision = decision
    target = "echo"
    if kind == "pr_review"
      target = "pr_reviewer"
    else if kind == "echo"
      target = "echo"
    memory.last_target = target
    node = TaskNode(task_id: task_id, status: "in_flight", blocked_on: [], specialist: target, project: "")
    memory.task_graph = memory.task_graph + [node]
    summary = "kind={kind} to {target} for task {task_id}"
    say "[mastermind] {summary} (reason-said {decision})"
    emit TaskRouted(task_id: task_id, target_agent: target, kind: kind, summary: summary, repo: repo, pr_number: pr_number, callback_url: callback_url, channel: channel, message: message)

  # T4.1 (#299): seed a node without going through LLM classification.
  # Used by the /seed_task smoke endpoint and by T4.2's cross-project
  # router, which already knows the target specialist.
  on SeedTask(task_id: Text, specialist: Text, project: Text)
    node = TaskNode(task_id: task_id, status: "in_flight", blocked_on: [], specialist: specialist, project: project)
    memory.task_graph = memory.task_graph + [node]
    say "[mastermind] seeded {task_id} specialist={specialist} project={project}"

  # T4.1 (#299): record blocker relations with 1-hop cycle refusal.
  # Cycle-check all proposed blockers up front so we commit once.
  on TaskBlocked(task_id: Text, blocked_on: Text[])
    cycle_blocker = first_cycling_blocker(memory.task_graph, task_id, blocked_on)
    if cycle_blocker != ""
      emit CycleDetected(task_id: task_id, blocker_id: cycle_blocker, note: "adding {cycle_blocker} as blocker of {task_id} would close a 1-hop cycle")
      say "[mastermind] CYCLE REJECTED: {task_id} cannot be blocked on {cycle_blocker}"
      memory.task_graph = update_task_node(memory.task_graph, task_id, "cycle_rejected", [])
      escalate to human
    else
      memory.task_graph = update_task_node(memory.task_graph, task_id, "blocked", blocked_on)
      say "[mastermind] {task_id} marked blocked"

  # T4.1 (#299): terminal signal; fan out UnblockTask to any
  # dependents that become fully free.
  on TaskCompleted(task_id: Text)
    newly_free = find_newly_unblocked(memory.task_graph, task_id)
    memory.task_graph = apply_completion(memory.task_graph, task_id)
    say "[mastermind] {task_id} done"
    for dep in newly_free
      emit UnblockTask(task_id: dep, unblocked_by: task_id)

  if stuck for 3 turns
    escalate to human

# ── Agent: pr_reviewer ─────────────────────────────────────────
# Forked from pr-review-bot/server.forge:48–117. Body kept intact;
# only the subscription changed (TaskRouted + where filter) and the
# incoming task_id is stored so the Observer trace can stitch hops.

agent pr_reviewer
  lifecycle: ReviewPhase
  memory
    task_id: Text
    repo: Text
    pr_number: Text
    channel: Text
    callback_url: Text
    pr_facts: Text
    ci_status: Text
    review_summary: Text
  subscribe TaskRouted where target_agent == "pr_reviewer"
  subscribe ApprovalResponse

  on start
    memory.task_id = ""
    memory.repo = ""
    memory.pr_number = ""
    memory.channel = ""
    memory.callback_url = ""
    memory.pr_facts = ""
    memory.ci_status = ""
    memory.review_summary = ""
    say "[pr_reviewer] ready"

  on TaskRouted(task_id: Text, target_agent: Text, kind: Text, summary: Text, repo: Text, pr_number: Text, callback_url: Text, channel: Text, message: Text)
    requires lifecycle == idle on fail: give "review already in progress"
    memory.task_id = task_id
    memory.repo = repo
    memory.pr_number = pr_number
    memory.channel = channel
    memory.callback_url = callback_url
    say "[pr_reviewer] {task_id}: Reviewing PR #{pr_number} in {repo}"
    pr_view = skill.github.get_pr(repo, pr_number)
    when pr_view.sure -> say "[pr_reviewer] PR metadata fetched"
    else -> say "[pr_reviewer] PR metadata fetch uncertain"
    memory.pr_facts = pr_view
    ci_check = skill.github.check_ci(repo, pr_number)
    when ci_check.sure -> say "[pr_reviewer] CI status fetched"
    else -> say "[pr_reviewer] CI status fetch uncertain"
    memory.ci_status = ci_check
    review_prompt = "Use ONLY the facts below - do not invent any details. Summarize this PR in 2 sentences for a reviewer. Mention the target branch and CI state. PR facts JSON: {memory.pr_facts} CI output: {memory.ci_status}"
    review = reason review_prompt
    when review.sure -> say "[pr_reviewer] Review summary generated"
    else -> say "[pr_reviewer] Review summary uncertain"
    memory.review_summary = review
    msg = "PR #{pr_number} in {repo} review: {memory.review_summary} - approve to merge or reject"
    transition to awaiting_approval
    notify = skill.slack.send_approval(channel, msg, callback_url, pr_number)
    when notify.sure -> say "[pr_reviewer] Approval message sent to Slack"
    else -> say "[pr_reviewer] Approval notification may have failed"

  on ApprovalResponse(request_id: Text, approved: Bool, comment: Text)
    requires lifecycle == awaiting_approval on fail: give "no pending review"
    requires request_id == memory.pr_number on fail: give "stale response"
    if approved
      say "[pr_reviewer] Merging PR {memory.pr_number} via gh CLI"
      merge_result = skill.github.merge_pr(memory.repo, memory.pr_number)
      when merge_result.sure -> say "[pr_reviewer] Merge command executed"
      else -> say "[pr_reviewer] Merge command uncertain"
      ann_prompt = "Use ONLY the facts below - do not invent any details. Write a short 2-sentence merge announcement. State the actual target branch from the PR facts and that the merge was just executed. Approver: {comment}. PR facts JSON: {memory.pr_facts} Merge command output: {merge_result}"
      summary = reason ann_prompt
      msg = "MERGED PR {memory.pr_number}: {summary}"
      followup = skill.slack.send_message(memory.channel, msg)
      say "[pr_reviewer] APPROVED and merged PR {memory.pr_number} by {comment}"
    if not approved
      reject_msg = "PR {memory.pr_number} REJECTED by {comment}"
      followup = skill.slack.send_message(memory.channel, reject_msg)
      say "[pr_reviewer] REJECTED PR {memory.pr_number} by {comment}"
    transition to idle

  if stuck for 3 turns
    escalate to human

# ── Agent: echo_specialist ─────────────────────────────────────
# Trivial second specialist — exists so the mastermind actually has
# to choose. Posts the inbound message back to Slack with the task_id
# prefix so the 3-hop trace is obvious in Slack too.

agent echo_specialist
  memory
    last_task_id: Text
    last_message: Text
    last_channel: Text
  subscribe TaskRouted where target_agent == "echo"

  on start
    memory.last_task_id = ""
    memory.last_message = ""
    memory.last_channel = ""
    say "[echo_specialist] ready"

  on TaskRouted(task_id: Text, target_agent: Text, kind: Text, summary: Text, repo: Text, pr_number: Text, callback_url: Text, channel: Text, message: Text)
    memory.last_task_id = task_id
    memory.last_message = message
    memory.last_channel = channel
    say "[echo_specialist] {task_id}: echoing to {channel}"
    out = "[clone-dev/{task_id}] {message}"
    result = skill.slack.send_message(channel, out)
    when result.sure -> say "[echo_specialist] posted to {channel}"
    else -> say "[echo_specialist] slack post uncertain"

  if stuck for 3 turns
    escalate to human

# ── Warden ─────────────────────────────────────────────────────
# Single warden supervising all three agents (per issue DoD).
# Policy mirrors pr-review-bot/server.forge:121–133.

warden org_warden
  manages [mastermind, pr_reviewer, echo_specialist]
  on stuck: nudge, self
    after 3: escalate
  on timeout: restart, self
  on crash: restart, self
  on hallucination: nudge, self
    after 2: escalate
  on contradiction: nudge, self
    after 2: escalate
  on budget: nudge, self
    after 1: escalate
  max_retries 3 per 1h then escalate

# ── System ─────────────────────────────────────────────────────

system clone_dev_system
  use
    mm: mastermind
    rev: pr_reviewer
    echo: echo_specialist

# ── Endpoints ──────────────────────────────────────────────────

endpoint health() -> Text
  give "ok"

# Accepts the flat union of pr_review + echo payloads. Form-encoded
# POST coercion lands via the #291 fix. Unused fields pass as empty
# strings from the caller.
endpoint clone_dev(kind: Text, repo: Text, pr_number: Text, callback_url: Text, channel: Text, message: Text) -> Text
  emit ClonedevTaskInbound(kind: kind, repo: repo, pr_number: pr_number, callback_url: callback_url, channel: channel, message: message)
  give "clone-dev task queued (kind={kind})"

# T4.1 (#299): smoke endpoints that drive the task-graph flows.
# /task_blocked emits TaskBlocked with a single blocker per call
# (repeat the call for multi-blocker chains). /task_completed
# emits TaskCompleted. Both are form-encoded POST.
endpoint task_blocked(task_id: Text, blocker_id: Text) -> Text
  emit TaskBlocked(task_id: task_id, blocked_on: [blocker_id])
  give "TaskBlocked queued (task={task_id} blocker={blocker_id})"

endpoint task_completed(task_id: Text) -> Text
  emit TaskCompleted(task_id: task_id)
  give "TaskCompleted queued (task={task_id})"

# T4.1 (#299): seed a task into the graph without going through the LLM
# classification path in `on ClonedevTaskInbound`. Mastermind subscribes
# and appends the node directly — useful for smoke-testing the graph
# flows (and for T4.2's cross-project router, which knows the target
# specialist up front).
event SeedTask
  task_id: Text
  specialist: Text
  project: Text

endpoint seed_task(task_id: Text, specialist: Text, project: Text) -> Text
  emit SeedTask(task_id: task_id, specialist: specialist, project: project)
  give "SeedTask queued (task={task_id} specialist={specialist})"

#! boundary: server

# Dev-cycle standalone config vocabulary — #496.
#
# `dev-cycle/agents.forge` calls `repo_config_for`, which the clone-dev
# assembly gets from `workflows/clone-dev/shared/types.forge`. The
# standalone dev-cycle build (see `forge.project.toml` and
# `clone-dev.toml`) composes only this directory, so the helper has to live
# here too. Copied verbatim rather than sourced: FORGE compose merges whole
# files, and clone-dev already carries its own copy for the same reason.

type RepoConfig
  slug: Text
  slack_channel: Text
  test_cmd: Text
  model_override: Text
  budget_per_task_usd: Number
  warden_max_retries: Number
  labels_extra: Text[]
  workdir_root: Text
  branch_prefix: Text
  commit_template: Text
  fix_commit_template: Text
  max_iterations: Number
  auto_approve: Bool
  max_plan_revisions: Number
  merge_pr: Bool

type CloneDevConfig
  org_name: Text
  slack_bot_token: Text
  slack_default_channel: Text
  slack_devops_channel: Text
  slack_signing_secret: Text
  github_token: Text
  github_labels_triage: Text[]
  github_labels_blocked: Text[]
  llm_routing_fast: Text
  llm_routing_balanced: Text
  llm_routing_high: Text
  warden_max_retries: Number
  warden_escalate_after_seconds: Number
  budget_per_task_usd: Number
  budget_per_hour_usd: Number
  gates_require_approval_for: Text[]
  gates_auto_approve_labels: Text[]
  gates_create_issue: Bool
  gates_create_issue_timeout_mins: Number
  gates_start_implementation: Bool
  gates_start_implementation_timeout_mins: Number
  gates_merge_pr: Bool
  gates_merge_pr_timeout_mins: Number
  slack_approval_channel: Text
  github_default_repo: Text
  label_routing_namespace: Text
  label_routing_suffixes: Text[]
  label_routing_targets: Text[]
  label_routing_triage_target: Text
  defaults_test_cmd: Text
  defaults_workdir_root: Text
  defaults_branch_prefix: Text
  defaults_commit_template: Text
  defaults_fix_commit_template: Text
  defaults_max_iterations: Number
  defaults_auto_approve: Bool
  defaults_max_plan_revisions: Number
  repos: RepoConfig[]

pure repo_config_for
  needs cfg: CloneDevConfig, slug: Text
  gives RepoConfig
  do
    for r in cfg.repos
      if r.slug == slug
        give r
      repo_slug = text.replace(r.slug, "/", "-")
      if repo_slug == slug
        give r
    give RepoConfig(slug: "", slack_channel: cfg.slack_default_channel, test_cmd: cfg.defaults_test_cmd, model_override: "", budget_per_task_usd: -1.0, warden_max_retries: -1.0, labels_extra: [], workdir_root: cfg.defaults_workdir_root, branch_prefix: cfg.defaults_branch_prefix, commit_template: cfg.defaults_commit_template, fix_commit_template: cfg.defaults_fix_commit_template, max_iterations: cfg.defaults_max_iterations, auto_approve: cfg.defaults_auto_approve, max_plan_revisions: cfg.defaults_max_plan_revisions, merge_pr: cfg.gates_merge_pr)


#! boundary: server

# ================================================================
# FORGE Clone-Developer — Top-Level Assembly (#356, T8.1)
# ================================================================
# The existential clone-developer program. Boots the full supervised
# swarm on ONE HTTP port, composing five imported pieces:
#
#   workflows/dev-cycle/agents.forge
#     • planner, implementer, tester, reviewer, release_manager
#     • swarm_mastery_coordinator + swarm_mastery_tuple (#303)
#
#   examples/agents/slack-adapter/agents.forge
#     • slack_adapter — the ONLY outbound Slack surface
#
#   shared/mastermind.forge
#     • clone-dev mastermind (follows mastermind-pattern #295
#       invariants, routes inbound into dev-cycle via IssueAssigned)
#
#   shared/types.forge + shared/events.forge
#     • TaskNode + 12 cycle-detection helpers (T4.1 #299 shape)
#     • CloneDevInbound, GithubIssueOpened/PrMerged, SlackMessage,
#       TaskBlocked / UnblockTask / CycleDetected, SeedTask,
#       CrossProjectRequested, TaskRouted (#358)
#
#   stage2/label_router.forge + stage2/triage_specialist.forge
#     • T8.3 (#358): pure deterministic label routing + visibility
#       fall-through agent for unmapped / multi-labeled / unlabeled
#       inbound issues.
#
#   stage1/mastermind_intake.forge
#     • T9.1 (#362): conversational classifier for fuzzy Slack-mention
#       intake. One persistent instance per Slack thread_ts (correlated
#       via #334). Routes investigation requests by domain to the
#       T9.2 (#363) investigators.
#
#   stage1/investigators/{code,ops,security}_investigator.forge
#     • T9.2 (#363): three domain specialists, each with an explicit
#       skill `allows` clause. Subscribe InvestigationRequested filtered
#       by domain; emit Finding(thread_ts, domain, summary, evidence,
#       confidence, suggested_action) which mastermind_intake stitches
#       back into the originating Slack thread.
#
#   stage1/solution_proposer.forge
#     • T9.3 (#364): Finding aggregator. correlate on Finding.thread_ts
#       + 2s quiet-window timer; once the batch quiesces, calls
#       `reason for plan` and emits ProposalReady(kind, content,
#       suggested_labels, evidence_refs, confidence) for the future
#       Gate-1 (T10.1) approval flow. Additive — intake's per-Finding
#       Slack stitch-back is unchanged.
#
#   stage1/issue_creator.forge
#     • T9.4 (#365): consumes ProposalApproved (kind == propose_issue)
#       from the Gate-1 flow (T10.1, future), calls
#       skill.github.create_labeled_issue, emits IssueCreated for
#       audit, and posts a confirmation back into the originating
#       Slack thread via PostMessage. One-retry policy: two sequential
#       skill calls before WardenEscalation.
#
# `org_warden` supervises the eleven core agents; `investigators_ward`
# adds bounded supervision for the T9.2 specialists, the T9.3 proposer,
# and the T9.4 issue_creator (same risk profile: narrow scope, single
# external skill call).
#
# HTTP surface (one port):
#   GET  /health                     → liveness probe
#   POST /clone_dev                  → direct API inbound
#   POST /task_blocked, /task_completed, /seed_task, /cross_project
#                                    → task-graph smoke endpoints
#   POST /wake/mastermind/{github_issue_opened, github_pr_merged,
#         slack_message}             → HMAC-verified webhook (#335)
#   POST /webhook/approval           → Slack approval callback
#                                     (runtime-built-in, auto-routed)
#   GET  /__forge/events             → live SSE trace
#   GET  /__forge/inspect/*          → topology / agents / wardens /
#                                     costs / mastery / schedules
#
# Run:
#   FORGE_CLONEDEV_CONFIG=... SLACK_BOT_TOKEN=xoxb-... \
#   ANTHROPIC_API_KEY=... \
#   cargo run -- serve \
#     --manifest workflows/clone-dev/forge.project.toml \
#     -s workflows/clone-dev/shared/types.forge \
#     -s workflows/clone-dev/shared/events.forge \
#     -s workflows/clone-dev/shared/mastermind.forge \
#     -s workflows/clone-dev/stage1/mastermind_intake.forge \
#     -s workflows/clone-dev/stage1/investigators/code_investigator.forge \
#     -s workflows/clone-dev/stage1/investigators/ops_investigator.forge \
#     -s workflows/clone-dev/stage1/investigators/security_investigator.forge \
#     -s workflows/clone-dev/stage1/solution_proposer.forge \
#     -s workflows/clone-dev/stage1/issue_creator.forge \
#     -s workflows/clone-dev/stage2/label_router.forge \
#     -s workflows/clone-dev/stage2/triage_specialist.forge \
#     -s workflows/dev-cycle/agents.forge \
#     -s examples/agents/slack-adapter/agents.forge \
#     workflows/clone-dev/main.forge --port 3300
#
# Register webhook secrets before opening traffic from GitHub/Slack:
#   forge wake rotate --agent mastermind --trigger github_issue_opened
#   forge wake rotate --agent mastermind --trigger github_pr_merged
#   forge wake rotate --agent mastermind --trigger slack_message
# ================================================================

# ── Warden: Org ──────────────────────────────────────────────────
# Single warden over the whole clone-dev swarm, enforcing the same
# escalation ladder as dev-cycle's `dev_lead` (from which this policy
# was copied verbatim).

warden org_warden
  manages [mastermind, mastermind_intake, planner, implementer, tester, reviewer, release_manager, triage_specialist, swarm_mastery_coordinator, swarm_mastery_tuple, slack_adapter]
  on stuck: nudge, self
    after 3: escalate
  on timeout: restart, self
  on crash: restart, self
  on hallucination: nudge, self
    after 3: escalate
  on contradiction: nudge, self
    after 2: escalate
  on budget: nudge, all
    after 1: restart
    after 3: escalate
  max_retries 3 per 1h then escalate

# ── Warden: Investigators (#363, T9.2) ──────────────────────────
# Bounded supervision for the three Stage-1 specialists. The per-
# turn `if stuck for 3 turns` block inside each investigator handles
# the soft escalation path (emits WardenEscalation, escalates to this
# warden); this declaration handles the hard cases (crash / timeout)
# uniformly across all three.
warden investigators_ward
  manages [code_investigator, ops_investigator, security_investigator, solution_proposer, issue_creator]
  on stuck: escalate, self
  on crash: restart, self
  on timeout: restart, self
  max_retries 3 per 1h then escalate

# ── System ───────────────────────────────────────────────────────
# Linear pipeline with mastermind as the intake and slack_adapter as
# a sink (all user-visible output flows through it). Mastery agents
# observe TaskCompleted out-of-band and don't need explicit wiring.

system clone_dev_system
  use
    mm: mastermind
    intake: mastermind_intake
    code_inv: code_investigator
    ops_inv: ops_investigator
    sec_inv: security_investigator
    proposer: solution_proposer
    issuer: issue_creator
    plan: planner
    impl: implementer
    test: tester
    review: reviewer
    release: release_manager
    triage: triage_specialist
    slack: slack_adapter
  mm >> plan >> impl >> test >> review

# ── Endpoints ────────────────────────────────────────────────────

endpoint health() -> Text
  give "ok"

# Primary inbound. Form-encoded POST; kind determines classification.
# kind ∈ {"github_issue", "slack_request", "observe", "ignore"}.
endpoint clone_dev(kind: Text, repo: Text, issue_id: Text, title: Text, body: Text, channel: Text, callback_url: Text, test_cmd: Text) -> Text
  emit CloneDevInbound(kind: kind, repo: repo, issue_id: issue_id, title: title, body: body, channel: channel, callback_url: callback_url, test_cmd: test_cmd)
  give "clone-dev task queued (kind={kind} repo={repo} issue={issue_id})"

# T4.1 (#299) smoke endpoints — drive the task-graph flows without
# needing a full classification trip.
endpoint task_blocked(task_id: Text, blocker_id: Text) -> Text
  emit TaskBlocked(task_id: task_id, blocked_on: [blocker_id])
  give "TaskBlocked queued (task={task_id} blocker={blocker_id})"

endpoint task_completed(task_id: Text, repo: Text, outcome: Text) -> Text
  emit TaskCompleted(task_id: task_id, repo: repo, outcome: outcome, ci_passed_first_try: false, review_rounds: 1, time_to_merge: 0, reverted_within_7d: false)
  give "TaskCompleted queued (task={task_id} outcome={outcome})"

endpoint seed_task(task_id: Text, specialist: Text, project: Text) -> Text
  emit SeedTask(task_id: task_id, specialist: specialist, project: project)
  give "SeedTask queued (task={task_id} specialist={specialist} project={project})"

# T4.2 (#354) — outgoing cross-project handoff trigger.
endpoint cross_project(source_task_id: Text, target_repo: Text, description: Text, labels: Text) -> Text
  emit CrossProjectRequested(source_task_id: source_task_id, target_repo: target_repo, description: description, labels: labels)
  give "CrossProjectRequested queued (source={source_task_id} target_repo={target_repo})"

# T9.1 (#362) — smoke endpoint for the Stage-1 mastermind_intake.
# Stands in for the future T9.5 (#366) slack_devops_monitor by emitting
# DevOpsRequest directly. mastermind_intake correlates on thread_ts so
# repeating calls with the same thread_ts route to the same agent
# instance (multi-turn conversation).
endpoint devops_request(channel: Text, user: Text, text: Text, thread_ts: Text, message_ts: Text) -> Text
  emit DevOpsRequest(channel: channel, user: user, text: text, thread_ts: thread_ts, message_ts: message_ts)
  give "DevOpsRequest queued (thread_ts={thread_ts} user={user})"

# T9.4 (#365) — smoke endpoint that stands in for the future T10.1
# Gate-1 approval flow. Operator passes the human-approved fields
# (repo / title / body) directly; suggested_labels is hardcoded to
# ["clone-dev:plan"] for the smoke. issue_creator picks it up via the
# `subscribe ProposalApproved where kind == "propose_issue"` filter.
endpoint smoke_propose_approved(thread_ts: Text, channel: Text, repo: Text, title: Text, body: Text) -> Text
  emit ProposalApproved(thread_ts: thread_ts, channel: channel, kind: "propose_issue", repo: repo, title: title, body: body, suggested_labels: ["clone-dev:plan"], evidence_refs: [])
  give "ProposalApproved queued (repo={repo} title={title})"

#! boundary: shared

# ================================================================
# Clone-Dev — Inbound & Task-Graph Events
# ================================================================
# Events specific to the clone-dev assembly. Events declared by the
# sourced dev-cycle (IssueAssigned, TaskCompleted, …) and slack-adapter
# (PostMessage, PostApproval, …) are reused, not redeclared.
# ================================================================

# Unified inbound for the clone-dev HTTP endpoint. The mastermind
# translates this into dev-cycle's IssueAssigned after classification.
event CloneDevInbound
  kind: Text
  repo: Text
  issue_id: Text
  title: Text
  body: Text
  channel: Text
  callback_url: Text
  test_cmd: Text

# Webhook-carried events. The WebhookDriver (#335) populates these
# fields from the POST JSON body; HMAC secrets are registered via
# `forge wake rotate --agent mastermind --trigger <name>`.
event GithubIssueOpened
  repo: Text
  issue_number: Number
  title: Text
  body: Text

event GithubPrMerged
  repo: Text
  pr_number: Number
  merged_by: Text

event SlackMessageReceived
  channel: Text
  user: Text
  text: Text

# T4.1 (#299): task-graph edges.
event TaskBlocked
  task_id: Text
  blocked_on: Text[]

event UnblockTask
  task_id: Text
  unblocked_by: Text

event CycleDetected
  task_id: Text
  blocker_id: Text
  note: Text

# T4.1 (#299): seed a node without going through LLM classification.
# Used by smoke endpoints and by T4.2 cross-project routing.
event SeedTask
  task_id: Text
  specialist: Text
  project: Text

# T4.2 (#354): outgoing cross-project handoff.
event CrossProjectRequested
  source_task_id: Text
  target_repo: Text
  description: Text
  labels: Text

# ================================================================
# T8.3 (#358) — deterministic label-based routing
# ================================================================
# `label_router_agent` (stage2/label_router_agent.forge) subscribes to
# `GithubIssueLabeled` (populated from a flat webhook body) and emits
# `TaskRouted` after consulting the pure `label_router` task. If two
# namespace-matching labels appear on one issue, a `RoutingConflict`
# event is emitted alongside a fallback `TaskRouted` to triage.
#
# NOTE: `GithubIssueLabeled` is a **flat** event. Native GitHub webhook
# payloads have nested `issue.labels[].name` — out of scope for T8.3;
# integration tests POST a pre-reshaped flat body. A follow-up issue
# will teach the wake webhook driver to extract nested GH fields.
event GithubIssueLabeled
  repo: Text
  issue_number: Number
  title: Text
  body: Text
  labels: Text[]

event TaskRouted
  task_id: Text
  specialist: Text
  issue_id: Text
  repo: Text
  labels: Text[]
  matched_label: Text
  route_reason: Text

event RoutingConflict
  issue_id: Text
  repo: Text
  labels: Text[]
  note: Text

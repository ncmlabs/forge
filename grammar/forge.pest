// =============================================================
// FORGE v3 PEG Grammar
// =============================================================
// No implicit WHITESPACE — all spacing is explicit.
// Indentation: 2-space fixed levels (i1, i2, i3, i4).
// v3 adds: pure, event, states, timer, boundary, requires,
//          match, if/else, for, operators, arrays.
// =============================================================

// --- Program structure ---
program   = { SOI ~ (boundary_directive ~ nl)? ~ (blank_line | top_level)* ~ EOI }
top_level = {
    import_decl
  | use_decl
  | pure_decl
  | event_decl
  | states_decl
  | type_decl
  | endpoint_decl
  | task_decl
  | flow_decl
  | agent_decl
  | pool_decl
  | warden_decl
  | contract_decl
  | system_decl
  | fn_main_decl
}

// --- Whitespace primitives ---
sp         = _{ " " | "\t" }
_s         = _{ sp+ }
_s_opt     = _{ sp* }
nl         = _{ _s_opt ~ comment? ~ NEWLINE }
blank_line = _{ _s_opt ~ comment? ~ NEWLINE }
NEWLINE    = _{ "\r\n" | "\n" }
comment    = _{ "#" ~ (!NEWLINE ~ ANY)* }
i1         = _{ "  " }
i2         = _{ "    " }
i3         = _{ "      " }
i4         = _{ "        " }

// --- Identifiers & Keywords ---
// Only true keywords that can NEVER be used as identifiers.
// Contextual keywords (memory, search, can, workers, strategy,
// lifecycle, on, fail, where, etc.) are handled by rule ordering
// and only reserved in their specific contexts.
keyword = @{
    ( "use" | "task" | "flow" | "agent" | "pool" | "warden" | "contract" | "system"
    | "fn" | "needs" | "gives" | "do" | "is" | "stage"
    | "if" | "else" | "when" | "give" | "say" | "reason" | "classify"
    | "into" | "true" | "false" | "or" | "with" | "escalate"
    | "to" | "try" | "above"
    | "pure" | "event" | "states" | "timer" | "endpoint" | "type"
    | "requires" | "emit" | "forward" | "subscribe" | "transition"
    | "start" | "cancel" | "reset" | "for" | "in" | "not" | "and"
    | "match" | "recall" | "learn"
    | "exportable" | "import" | "from" | "as" )
    ~ !(ASCII_ALPHANUMERIC | "_")
}

ident = @{ !keyword ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// --- Literals ---
number_lit = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
bool_lit   = @{ ("true" | "false") ~ !(ASCII_ALPHANUMERIC | "_") }

// Template string: allows {expr} interpolation
template_string = ${ "\"" ~ template_part* ~ "\"" }
template_part   =  { template_interp | template_escape | template_text }
template_interp =  { "{" ~ _s_opt ~ expr ~ _s_opt ~ "}" }
template_escape = @{ "\\" ~ ("n" | "r" | "t" | "\"" | "\\") }
template_text   = @{ (!("\"" | "{" | "\\") ~ ANY)+ }

// --- Type names ---
builtin_type = @{
    ( "Text" | "Number" | "Bool" | "Results" | "Report" | "Intent"
    | "Summary" | "Failure" | "Classification" | "Conversation"
    | "Profile" | "SearchResults" | "Request" | "Response" | "Headers" )
    ~ !(ASCII_ALPHANUMERIC | "_")
}
type_name    = { (builtin_type | ident) ~ array_suffix? }
array_suffix = { "[" ~ _s_opt ~ number_lit? ~ _s_opt ~ "]" }

// --- Boundary directive (file-level) ---
boundary_directive = { "#!" ~ _s_opt ~ "boundary" ~ _s_opt ~ ":" ~ _s_opt ~ boundary_kind }
boundary_kind      = @{ ("server" | "client" | "shared") ~ !(ASCII_ALPHANUMERIC | "_") }

// --- use declaration ---
use_decl = {
    "use" ~ nl ~
    (i1 ~ cap_path ~ nl)+
}
cap_path = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* ~ ("." ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*)+ }

// --- import declaration ---
import_decl = {
    "import" ~ _s ~ import_layer_list ~ _s ~ "from" ~ _s ~ template_string ~ _s ~ "as" ~ _s ~ ident ~ nl
}
import_layer_list = { ident ~ (_s_opt ~ "," ~ _s_opt ~ ident)* }

// --- task declaration ---
task_decl = {
    "task" ~ _s ~ ident ~ nl ~
    (i1 ~ needs_clause ~ nl)? ~
    (i1 ~ gives_clause ~ nl)? ~
    ( i1 ~ do_block | i1 ~ is_clause ~ nl ) ~
    (i1 ~ if_fails_block)?
}

needs_clause = { "needs" ~ _s ~ param ~ (_s_opt ~ "," ~ _s_opt ~ param)* }
gives_clause = { "gives" ~ _s ~ output_type }
output_type  = { type_name ~ (_s ~ "or" ~ _s ~ type_name)* }

param      = { ident ~ _s_opt ~ ":" ~ _s_opt ~ type_name }
param_list = { param ~ (_s_opt ~ "," ~ _s_opt ~ param)* }

is_clause = { "is" ~ _s ~ compose_expr }

do_block = {
    "do" ~ nl ~
    (i2 ~ statement ~ nl)+
}

if_fails_block = {
    "if" ~ _s ~ "fails" ~ nl ~
    (i2 ~ statement ~ nl)+
}

// --- pure declaration ---
pure_decl = {
    "pure" ~ _s ~ ident ~ nl ~
    (i1 ~ needs_clause ~ nl)? ~
    (i1 ~ gives_clause ~ nl)? ~
    i1 ~ do_block
}

// --- event declaration ---
event_decl = {
    "event" ~ _s ~ ident ~ nl ~
    (i1 ~ ident ~ _s_opt ~ ":" ~ _s_opt ~ type_name ~ nl)+
}

// --- states declaration ---
states_decl = {
    "states" ~ _s ~ ident ~ nl ~
    (i1 ~ state_transition ~ nl)+
}
state_transition = { ident ~ _s_opt ~ "->" ~ _s_opt ~ ident ~ (_s ~ "when" ~ _s ~ expr)? }

// --- type declaration (record types for shared boundary) ---
type_decl = {
    "type" ~ _s ~ ident ~ nl ~
    (i1 ~ ident ~ _s_opt ~ ":" ~ _s_opt ~ type_name ~ nl)+
}

// --- endpoint declaration ---
endpoint_decl = {
    "endpoint" ~ _s ~ ident ~ "(" ~ _s_opt ~ param_list? ~ _s_opt ~ ")" ~
    (_s_opt ~ "->" ~ _s_opt ~ output_type)? ~ nl ~
    (i1 ~ statement ~ nl)+
}

// --- flow declaration ---
flow_decl = {
    "flow" ~ _s ~ ident ~ nl ~
    (i1 ~ needs_clause ~ nl)? ~
    (i1 ~ gives_clause ~ nl)? ~
    (blank_line | stage_block)+
}

stage_block = {
    i1 ~ "stage" ~ _s ~ ident ~ nl ~
    (i2 ~ "needs" ~ _s ~ needs_ref_list ~ nl)? ~
    (blank_line | i2 ~ statement ~ nl)+
}

needs_ref_list = { needs_ref ~ (_s_opt ~ "," ~ _s_opt ~ needs_ref)* }
needs_ref      = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* ~ "." ~ ("*" | (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*) }

// --- agent declaration ---
agent_decl = {
    ("exportable" ~ _s)? ~ "agent" ~ _s ~ ident ~ nl ~
    (i1 ~ lifecycle_clause ~ nl)? ~
    (i1 ~ memory_block)? ~
    (i1 ~ knowledge_block)? ~
    (i1 ~ timer_field ~ nl)* ~
    (i1 ~ subscribe_line ~ nl)* ~
    (i1 ~ warden_override_block)? ~
    (blank_line | on_handler)+ ~
    (i1 ~ stuck_policy)?
}

lifecycle_clause = { "lifecycle" ~ _s_opt ~ ":" ~ _s_opt ~ ident }

memory_block = {
    "memory" ~ nl ~
    (i2 ~ ident ~ _s_opt ~ ":" ~ _s_opt ~ type_name ~ nl)+
}

knowledge_block = {
    "knowledge" ~ _s ~ "store" ~ _s_opt ~ ":" ~ _s_opt ~ template_string ~ nl ~
    (i2 ~ knowledge_option ~ nl)*
}
knowledge_option = {
    "max_entries" ~ _s_opt ~ ":" ~ _s_opt ~ number_lit
  | "retention" ~ _s_opt ~ ":" ~ _s_opt ~ duration
  | "import" ~ _s_opt ~ ":" ~ _s_opt ~ ident_list
}

timer_field = { "timer" ~ _s ~ ident ~ _s_opt ~ ":" ~ _s_opt ~ duration }

subscribe_line = { "subscribe" ~ _s ~ ident ~ (_s ~ "where" ~ _s ~ expr)? }

on_handler = {
    i1 ~ "on" ~ _s ~ handler_event_name ~
    (_s_opt ~ "(" ~ _s_opt ~ param_list? ~ _s_opt ~ ")")? ~
    (_s_opt ~ ":" ~ _s_opt ~ type_name)? ~
    nl ~
    (i2 ~ requires_clause ~ nl)* ~
    (i2 ~ statement ~ nl)+
}

// Supports dotted names like reconnect_window.expired
handler_event_name = @{
    (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* ~
    ("." ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*)*
}

requires_clause = {
    "requires" ~ _s ~ expr ~
    (_s_opt ~ "on" ~ _s ~ "fail" ~ _s_opt ~ ":" ~ _s_opt ~ fail_policy)?
}

fail_policy = {
    "silent" | "log" | "escalate" | "crash" | "give" ~ _s ~ expr
}

stuck_policy = {
    "if" ~ _s ~ "stuck" ~ (_s ~ "for" ~ _s ~ number_lit ~ _s ~ "turns")? ~ nl ~
    (i2 ~ statement ~ nl)+
}

// --- pool declaration ---
pool_decl = {
    "pool" ~ _s ~ ident ~ nl ~
    i1 ~ "workers" ~ _s_opt ~ ":" ~ _s_opt ~ ident ~ _s ~ "*" ~ _s ~ number_lit ~ nl ~
    i1 ~ "strategy" ~ _s_opt ~ ":" ~ _s_opt ~ pool_strategy ~ nl ~
    (i1 ~ "timeout" ~ _s_opt ~ ":" ~ _s_opt ~ duration ~ nl)? ~
    (i1 ~ "fallback" ~ _s_opt ~ ":" ~ _s_opt ~ ident ~ nl)?
}

pool_strategy = {
    "fastest" | "all" | "majority"
  | "quorum(" ~ _s_opt ~ number_lit ~ _s_opt ~ ")"
  | "first(" ~ _s_opt ~ number_lit ~ _s_opt ~ ")"
}
duration = @{ ASCII_DIGIT+ ~ ("min" | "s" | "m" | "h" | "d") }

// --- warden declaration ---
warden_decl = {
    "warden" ~ _s ~ ident ~ nl ~
    i1 ~ manages_clause ~ nl ~
    (blank_line | i1 ~ ward_policy ~ nl)* ~
    (i1 ~ max_retries_clause ~ nl)?
}

manages_clause = { "manages" ~ _s_opt ~ "[" ~ _s_opt ~ ident_list ~ _s_opt ~ "]" }
ident_list     = { ident ~ (_s_opt ~ "," ~ _s_opt ~ ident)* }

ward_policy = {
    "on" ~ _s ~ failure_type ~ _s_opt ~ ":" ~ _s_opt ~ ward_response ~ _s_opt ~ "," ~ _s_opt ~ ward_scope ~
    (nl ~ i2 ~ after_clause)*
}

failure_type = @{ ("stuck" | "crash" | "hallucination" | "budget" | "timeout") ~ !(ASCII_ALPHANUMERIC | "_") }

ward_response = @{ ("nudge" | "restart" | "replace" | "escalate") ~ !(ASCII_ALPHANUMERIC | "_") }

ward_scope = @{ ("self" | "downstream" | "all") ~ !(ASCII_ALPHANUMERIC | "_") }

after_clause = { "after" ~ _s ~ number_lit ~ _s_opt ~ ":" ~ _s_opt ~ ward_response }

max_retries_clause = {
    "max_retries" ~ _s ~ number_lit ~ _s ~ "per" ~ _s ~ duration ~ _s ~ "then" ~ _s ~ "escalate"
}

// --- warden_override block inside agent declarations ---
warden_override_block = {
    "warden_override" ~ nl ~
    (i2 ~ ward_policy ~ nl)*
}

// --- contract declaration ---
contract_decl = {
    "contract" ~ _s ~ ident ~ nl ~
    (i1 ~ can_signature ~ nl)+
}

can_signature = {
    "can" ~ _s ~ ident ~ _s_opt ~ "(" ~ _s_opt ~ param_list? ~ _s_opt ~ ")"
    ~ _s_opt ~ "->" ~ _s_opt ~ type_name
}

// --- system declaration ---
system_decl = {
    "system" ~ _s ~ ident ~ nl ~
    (i1 ~ "use" ~ nl ~ (i2 ~ ident ~ _s_opt ~ ":" ~ _s_opt ~ ident ~ nl)+)? ~
    (blank_line | i1 ~ compose_expr ~ nl)*
}

// --- fn main ---
fn_main_decl = {
    "fn" ~ _s ~ "main" ~ nl ~
    (i1 ~ statement ~ nl)*
}

// --- Statements (i2 level, inside do blocks) ---
statement = {
    when_block
  | match_stmt
  | if_else_stmt
  | for_loop
  | give_stmt
  | say_stmt
  | emit_stmt
  | learn_stmt
  | transition_stmt
  | start_timer_stmt
  | cancel_timer_stmt
  | reset_timer_stmt
  | forward_stmt
  | escalate_stmt
  | memory_update_stmt
  | bind_stmt
  | expr_stmt
}

bind_stmt          = { ident ~ _s_opt ~ "=" ~ _s_opt ~ expr }
give_stmt          = { "give" ~ _s ~ expr ~ (_s ~ "with" ~ _s ~ give_meta_list)? }
give_meta_list     = { give_meta ~ (_s_opt ~ "," ~ _s_opt ~ give_meta)* }
give_meta          = { ident ~ _s_opt ~ ":" ~ _s_opt ~ expr }
say_stmt           = { "say" ~ _s ~ expr }
escalate_stmt      = { "escalate" ~ _s ~ "to" ~ _s ~ ident }
memory_update_stmt = { "memory" ~ "." ~ ident ~ (_s_opt ~ "[" ~ _s_opt ~ expr ~ _s_opt ~ "]")? ~ _s_opt ~ "=" ~ _s_opt ~ expr }
expr_stmt          = { expr }

emit_stmt          = { "emit" ~ _s ~ ident ~ "(" ~ _s_opt ~ arg_list? ~ _s_opt ~ ")" }
transition_stmt    = { "transition" ~ _s ~ "to" ~ _s ~ ident }
start_timer_stmt   = { "start" ~ _s ~ ident ~ (_s ~ "for" ~ _s ~ expr)? }
cancel_timer_stmt  = { "cancel" ~ _s ~ ident ~ (_s ~ "for" ~ _s ~ expr)? }
reset_timer_stmt   = { "reset" ~ _s ~ ident }
forward_stmt       = { "forward" ~ _s ~ expr ~ _s ~ "to" ~ _s ~ expr }

learn_stmt         = { "learn" ~ _s ~ (learn_from_interaction | learn_from_document | learn_direct) }
learn_from_interaction = { "from" ~ _s ~ "interaction" ~ _s_opt ~ "(" ~ _s_opt ~ arg_list ~ _s_opt ~ ")" }
learn_from_document    = { "from" ~ _s ~ "document" ~ _s_opt ~ "(" ~ _s_opt ~ string_arg ~ _s_opt ~ ")" }
learn_direct           = { string_arg }

// --- when block (confidence-only branching) ---
when_block = {
    when_clause ~
    (same_indent_when ~ when_clause)* ~
    (same_indent_else ~ else_clause)?
}

// These rules match the indentation for subsequent when/else lines.
// Inside a do_block (i2 indent), subsequent when/else appear at i2.
same_indent_when = _{ nl ~ i2 }
same_indent_else = _{ nl ~ i2 }

when_clause = { "when" ~ _s ~ conf_predicate ~ _s_opt ~ "->" ~ _s_opt ~ statement_inline }
else_clause = { "else" ~ _s_opt ~ "->" ~ _s_opt ~ statement_inline }

statement_inline = {
    give_stmt | say_stmt | escalate_stmt
  | emit_stmt | learn_stmt | transition_stmt
  | start_timer_stmt | cancel_timer_stmt | reset_timer_stmt
  | forward_stmt | expr_stmt
}

// --- match statement (structural pattern matching) ---
// Does NOT consume trailing nl — caller (do_block) handles it.
match_stmt = {
    "match" ~ _s ~ expr ~ nl ~
    i3 ~ match_arm ~ (nl ~ i3 ~ match_arm)*
}

match_arm = { pattern ~ _s_opt ~ "->" ~ _s_opt ~ statement_inline }

// Patterns: wildcard (_), constructor (Uppercase with optional args), binding (lowercase)
pattern = { wildcard_pattern | constructor_pattern | binding_pattern }
wildcard_pattern    = { "_" }
constructor_pattern = {
    ASCII_ALPHA_UPPER ~ (ASCII_ALPHANUMERIC | "_")* ~
    ("(" ~ _s_opt ~ (pattern ~ (_s_opt ~ "," ~ _s_opt ~ pattern)*)? ~ _s_opt ~ ")")?
}
binding_pattern     = @{ !keyword ~ ASCII_ALPHA_LOWER ~ (ASCII_ALPHANUMERIC | "_")* }

// --- if/else statement (boolean conditions) ---
// Does NOT consume trailing nl — caller (do_block) handles it.
if_else_stmt = {
    "if" ~ _s ~ expr ~ nl ~
    i3 ~ statement_i3 ~ (nl ~ i3 ~ statement_i3)* ~
    (nl ~ i2 ~ "else" ~ _s ~ "if" ~ _s ~ expr ~ nl ~
     i3 ~ statement_i3 ~ (nl ~ i3 ~ statement_i3)*)* ~
    (nl ~ i2 ~ "else" ~ nl ~
     i3 ~ statement_i3 ~ (nl ~ i3 ~ statement_i3)*)?
}

// --- for loop ---
// Does NOT consume trailing nl — caller (do_block) handles it.
for_loop = {
    "for" ~ _s ~ ident ~ _s ~ "in" ~ _s ~ expr ~ nl ~
    i3 ~ statement_i3 ~ (nl ~ i3 ~ statement_i3)*
}

// --- Statements at i3 level (inside if/for/match blocks) ---
// These can nest one more level (bodies at i4) but no deeper.
statement_i3 = {
    when_block_i3
  | match_stmt_i3
  | if_else_stmt_i3
  | for_loop_i3
  | give_stmt
  | say_stmt
  | emit_stmt
  | learn_stmt
  | transition_stmt
  | start_timer_stmt
  | cancel_timer_stmt
  | reset_timer_stmt
  | forward_stmt
  | escalate_stmt
  | memory_update_stmt
  | bind_stmt
  | expr_stmt
}

when_block_i3 = {
    when_clause_i3 ~
    (nl ~ i3 ~ when_clause_i3)* ~
    (nl ~ i3 ~ else_clause)?
}
when_clause_i3 = { "when" ~ _s ~ conf_predicate ~ _s_opt ~ "->" ~ _s_opt ~ statement_inline }

match_stmt_i3 = {
    "match" ~ _s ~ expr ~ nl ~
    i4 ~ match_arm ~ (nl ~ i4 ~ match_arm)*
}

if_else_stmt_i3 = {
    "if" ~ _s ~ expr ~ nl ~
    i4 ~ statement_i4 ~ (nl ~ i4 ~ statement_i4)* ~
    (nl ~ i3 ~ "else" ~ _s ~ "if" ~ _s ~ expr ~ nl ~
     i4 ~ statement_i4 ~ (nl ~ i4 ~ statement_i4)*)* ~
    (nl ~ i3 ~ "else" ~ nl ~
     i4 ~ statement_i4 ~ (nl ~ i4 ~ statement_i4)*)?
}

for_loop_i3 = {
    "for" ~ _s ~ ident ~ _s ~ "in" ~ _s ~ expr ~ nl ~
    i4 ~ statement_i4 ~ (nl ~ i4 ~ statement_i4)*
}

// --- Statements at i4 level (leaf — no further nesting) ---
statement_i4 = {
    give_stmt
  | say_stmt
  | emit_stmt
  | learn_stmt
  | transition_stmt
  | start_timer_stmt
  | cancel_timer_stmt
  | reset_timer_stmt
  | forward_stmt
  | escalate_stmt
  | memory_update_stmt
  | bind_stmt
  | expr_stmt
}

// --- Confidence predicates ---
conf_predicate = {
    ident ~ "." ~ "sure" ~ "(" ~ _s_opt ~ "above" ~ _s_opt ~ ":" ~ _s_opt ~ number_lit ~ _s_opt ~ ")"
  | ident ~ "." ~ conf_level
}
conf_level = @{ ("sure" | "unsure" | "unreliable" | "conflicted") ~ !(ASCII_ALPHANUMERIC | "_") }

// --- Expressions ---
// Precedence (lowest to highest):
//   compose (>>)  →  or  →  and  →  comparison  →  additive  →
//   multiplicative  →  unary  →  fan_out  →  postfix  →  pipe_term  →  atom
expr = { compose_expr }

compose_expr = { or_expr ~ (_s_opt ~ ">>" ~ _s_opt ~ or_expr)* }

or_expr  = { and_expr ~ (_s ~ "or" ~ _s ~ and_expr)* }
and_expr = { comparison_expr ~ (_s ~ "and" ~ _s ~ comparison_expr)* }

comparison_expr = { additive_expr ~ (_s_opt ~ comparison_op ~ _s_opt ~ additive_expr)? }
comparison_op   = { "==" | "!=" | ">=" | "<=" | ">" | "<" }

additive_expr       = { multiplicative_expr ~ (_s_opt ~ additive_op ~ _s_opt ~ multiplicative_expr)* }
additive_op         = { "+" | "-" }
multiplicative_expr = { unary_expr ~ (_s_opt ~ multiplicative_op ~ _s_opt ~ unary_expr)* }
multiplicative_op   = { "*" | "/" }

unary_expr = { unary_op? ~ fan_out_expr }
unary_op   = { "not" ~ _s | "-" }

fan_out_expr = {
    "(" ~ _s_opt ~ postfix_expr ~ (_s_opt ~ "|" ~ _s_opt ~ postfix_expr)+ ~ _s_opt ~ ")"
  | postfix_expr
}

postfix_expr = { pipe_term ~ postfix_op* }
postfix_op   = {
    "[" ~ _s_opt ~ expr ~ _s_opt ~ "]"
  | "." ~ ident ~ "(" ~ _s_opt ~ arg_list? ~ _s_opt ~ ")"
  | "." ~ (ident | "*")
}

pipe_term = {
    reason_expr
  | classify_expr
  | search_expr
  | recall_expr
  | try_or_expr
  | constructor_expr
  | call_expr
  | atom
}

reason_expr   = { "reason" ~ _s ~ string_arg }
classify_expr = { "classify" ~ _s ~ atom ~ _s ~ "into" ~ _s ~ label_list }
search_expr   = { "search" ~ _s ~ string_arg }
recall_expr   = { "recall" ~ _s ~ string_arg }
try_or_expr   = { "try" ~ _s ~ and_expr ~ _s ~ "or" ~ _s ~ expr }

string_arg = { template_string | ident }

label_list = { "[" ~ _s_opt ~ template_string
               ~ (_s_opt ~ "," ~ _s_opt ~ template_string)* ~ _s_opt ~ "]" }

constructor_expr = { builtin_type ~ "(" ~ _s_opt ~ arg_list? ~ _s_opt ~ ")" }

call_expr = { ident ~ "(" ~ _s_opt ~ arg_list? ~ _s_opt ~ ")" }
arg_list  = { call_arg ~ (_s_opt ~ "," ~ _s_opt ~ call_arg)* }
call_arg  = { (ident ~ _s_opt ~ ":" ~ _s_opt)? ~ expr }

atom = {
    template_string
  | number_lit
  | bool_lit
  | array_lit
  | type_dot_access
  | ident
  | "(" ~ _s_opt ~ expr ~ _s_opt ~ ")"
}

array_lit = { "[" ~ _s_opt ~ (expr ~ (_s_opt ~ "," ~ _s_opt ~ expr)*)? ~ _s_opt ~ "]" }

// For Intent.unknown, Conversation.empty, etc.
type_dot_access = { builtin_type ~ "." ~ ident }

// =============================================================
// FORGE v3 PEG Grammar
// =============================================================
// No implicit WHITESPACE — all spacing is explicit.
// Indentation: 2-space fixed levels (i1, i2, i3, i4).
// v3 adds: pure, event, states, timer, boundary, requires,
//          match, if/else, for, operators, arrays.
// =============================================================

// --- Program structure ---
program   = { SOI ~ (boundary_directive ~ nl)? ~ (blank_line | top_level)* ~ EOI }
top_level = {
    import_decl
  | use_decl
  | pure_decl
  | event_decl
  | states_decl
  | type_decl
  | endpoint_decl
  | task_decl
  | flow_decl
  | agent_decl
  | pool_decl
  | warden_decl
  | contract_decl
  | system_decl
  | fn_main_decl
}

// --- Whitespace primitives ---
sp         = _{ " " | "\t" }
_s         = _{ sp+ }
_s_opt     = _{ sp* }
nl         = _{ _s_opt ~ comment? ~ NEWLINE }
blank_line = _{ _s_opt ~ comment? ~ NEWLINE }
NEWLINE    = _{ "\r\n" | "\n" }
comment    = _{ "#" ~ (!NEWLINE ~ ANY)* }
i1         = _{ "  " }
i2         = _{ "    " }
i3         = _{ "      " }
i4         = _{ "        " }

// --- Identifiers & Keywords ---
// Only true keywords that can NEVER be used as identifiers.
//
// ---- Contextual keywords ----
// These tokens are reserved only in specific grammar slots; they are valid
// identifiers elsewhere. Mixed: RHS-of-slot keywords (e.g. `on`, `where`,
// `can`) and enumerable slot values (e.g. `fastest`, `sure`).
//
// Authoritative list — `token -> enforcing-rule(s)`. Alphabetized. Any token
// reserved anywhere in this grammar appears in exactly one of: (a) the
// `keyword` rule below, or (b) this block. The surface audit reads this
// block as the source of truth for contextually-reserved keywords; see
// `scripts/audit-forge-surface.prompt.md`.
//
//   after           -> after_clause
//   all             -> find_expr / ward_scope / pool_strategy
//   at              -> schedule_when_daily
//   boundary        -> boundary_directive
//   budget          -> session_budget_modifier / failure_type
//   can             -> can_signature
//   category        -> category_clause / spawn_knowledge_pred
//   client          -> boundary_kind
//   complete        -> session_hook_kind
//   confidence_cap  -> spawn_confidence_cap_option
//   conflicted      -> conf_level
//   contradiction   -> failure_type
//   crash           -> fail_policy / failure_type
//   cron            -> schedule_when_cron
//   daily           -> schedule_when_daily
//   document        -> learn_from_document
//   downstream      -> ward_scope
//   every           -> schedule_when_every
//   export          -> retire_knowledge_export
//   fail            -> requires_clause (on-fail)
//   fails           -> if_fails_block
//   fallback        -> pool_decl
//   fastest         -> pool_strategy
//   first           -> pool_strategy
//   hallucination   -> failure_type
//   high            -> schedule_precision_value
//   interaction     -> learn_from_interaction
//   isolate         -> spawn_isolate_option / session_isolate_modifier
//   knowledge       -> knowledge_block / spawn_knowledge_option / retire_knowledge_export
//   lifecycle       -> lifecycle_clause
//   log             -> fail_policy
//   main            -> fn_main_decl
//   majority        -> pool_strategy
//   manages         -> manages_clause
//   max_entries     -> knowledge_option
//   max_retries     -> max_retries_clause
//   memory          -> memory_block / memory_update_stmt
//   mode            -> schedule_mode
//   nudge           -> ward_response
//   on              -> on_handler / ward_policy / session_hook_modifier
//   per             -> max_retries_clause
//   persistent      -> memory_block
//   precision       -> schedule_precision
//   progress        -> session_hook_kind
//   prompt          -> session_prompt_modifier / schedule_prompt
//   quorum          -> pool_strategy
//   replace         -> ward_response
//   restart         -> ward_response
//   retention       -> knowledge_option
//   search          -> search_expr (oracle call)
//   self            -> ward_scope
//   server          -> boundary_kind
//   shared          -> boundary_kind
//   silent          -> fail_policy
//   store           -> knowledge_block
//   strategy        -> pool_decl
//   stuck           -> stuck_policy / failure_type
//   sure            -> conf_level
//   then            -> max_retries_clause
//   timeout         -> pool_decl / session_timeout_modifier / command_modifier / failure_type
//   tools           -> session_tools_modifier
//   turns           -> stuck_policy
//   unreliable      -> conf_level
//   unsure          -> conf_level
//   wake            -> schedule_mode_value
//   warden_override -> warden_override_block
//   where           -> subscribe_line / spawn_knowledge_option / find_expr
//   workers         -> pool_decl
//   worktree        -> spawn_isolate_option / session_isolate_modifier
//
keyword = @{
    ( "use" | "task" | "flow" | "agent" | "pool" | "warden" | "contract" | "system"
    | "fn" | "needs" | "gives" | "do" | "is" | "stage"
    | "if" | "else" | "when" | "give" | "say" | "reason" | "classify"
    | "into" | "true" | "false" | "or" | "with" | "escalate" | "downgrade"
    | "to" | "try" | "above"
    | "pure" | "event" | "states" | "timer" | "endpoint" | "type"
    | "requires" | "emit" | "forward" | "subscribe" | "transition"
    | "start" | "cancel" | "reset" | "for" | "in" | "not" | "and"
    | "match" | "recall" | "learn" | "spawn" | "find" | "retire"
    | "exec" | "exportable" | "import" | "from" | "as" | "command" | "background"
    | "session" | "schedule" )
    ~ !(ASCII_ALPHANUMERIC | "_")
}

ident = @{ !keyword ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// --- Literals ---
number_lit = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
bool_lit   = @{ ("true" | "false") ~ !(ASCII_ALPHANUMERIC | "_") }

// Template string: allows {expr} interpolation
template_string = ${ "\"" ~ template_part* ~ "\"" }
template_part       =  { template_interp_raw | template_interp | template_escape | template_text }
template_interp     =  { "{" ~ _s_opt ~ expr ~ _s_opt ~ "}" }
template_interp_raw =  { "{!" ~ _s_opt ~ expr ~ _s_opt ~ "}" }
// `\{` and `\}` allow literal braces inside template strings so the
// program can pass placeholder text (e.g. "{issue_id}") to runtime helpers
// like text.replace without the parser eating it as `{expr}` interpolation.
// Issue #360 (T8.5).
template_escape = @{ "\\" ~ ("n" | "r" | "t" | "\"" | "\\" | "{" | "}") }
template_text   = @{ (!("\"" | "{" | "\\") ~ ANY)+ }

// --- Type names ---
builtin_type = @{
    ( "Text" | "Number" | "Bool" | "Results" | "Report" | "Intent"
    | "Summary" | "Failure" | "Classification" | "Conversation"
    | "Profile" | "SearchResults" | "Request" | "Response" | "Headers" | "Html"
    | "AgentResult" )
    ~ !(ASCII_ALPHANUMERIC | "_")
}
type_name    = { (builtin_type | ident) ~ array_suffix? }
array_suffix = { "[" ~ _s_opt ~ number_lit? ~ _s_opt ~ "]" }

// --- Boundary directive (file-level) ---
boundary_directive = { "#!" ~ _s_opt ~ "boundary" ~ _s_opt ~ ":" ~ _s_opt ~ boundary_kind }
boundary_kind      = @{ ("server" | "client" | "shared") ~ !(ASCII_ALPHANUMERIC | "_") }

// --- use declaration ---
use_decl = {
    "use" ~ nl ~
    (i1 ~ cap_path ~ nl)+
}
cap_path = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* ~ ("." ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*)+ }

// --- import declaration ---
import_decl = {
    "import" ~ _s ~ import_layer_list ~ _s ~ "from" ~ _s ~ template_string ~ _s ~ "as" ~ _s ~ ident ~ nl
}
import_layer_list = { ident ~ (_s_opt ~ "," ~ _s_opt ~ ident)* }

// --- task declaration ---
task_decl = {
    "task" ~ _s ~ ident ~ nl ~
    (i1 ~ needs_clause ~ nl)? ~
    (i1 ~ gives_clause ~ nl)? ~
    ( i1 ~ do_block | i1 ~ is_clause ~ nl ) ~
    (i1 ~ if_fails_block)?
}

needs_clause = { "needs" ~ _s ~ param ~ (_s_opt ~ "," ~ _s_opt ~ param)* }
gives_clause = { "gives" ~ _s ~ output_type }
output_type  = { type_name ~ (_s ~ "or" ~ _s ~ type_name)* }

param      = { ident ~ _s_opt ~ ":" ~ _s_opt ~ type_name }
param_list = { param ~ (_s_opt ~ "," ~ _s_opt ~ param)* }

is_clause = { "is" ~ _s ~ compose_expr }

do_block = {
    "do" ~ nl ~
    (i2 ~ statement ~ nl)+
}

if_fails_block = {
    "if" ~ _s ~ "fails" ~ nl ~
    (i2 ~ statement ~ nl)+
}

// --- pure declaration ---
pure_decl = {
    "pure" ~ _s ~ ident ~ nl ~
    (i1 ~ needs_clause ~ nl)? ~
    (i1 ~ gives_clause ~ nl)? ~
    i1 ~ do_block
}

// --- event declaration ---
event_decl = {
    "event" ~ _s ~ ident ~ nl ~
    (i1 ~ ident ~ _s_opt ~ ":" ~ _s_opt ~ type_name ~ nl)+
}

// --- states declaration ---
states_decl = {
    "states" ~ _s ~ ident ~ nl ~
    (i1 ~ state_transition ~ nl)+
}
state_transition = { ident ~ _s_opt ~ "->" ~ _s_opt ~ ident ~ (_s ~ "when" ~ _s ~ expr)? }

// --- type declaration (record types for shared boundary) ---
type_decl = {
    "type" ~ _s ~ ident ~ nl ~
    (i1 ~ ident ~ _s_opt ~ ":" ~ _s_opt ~ type_name ~ nl)+
}

// --- endpoint declaration ---
endpoint_decl = {
    "endpoint" ~ _s ~ ident ~ "(" ~ _s_opt ~ param_list? ~ _s_opt ~ ")" ~
    (_s_opt ~ "->" ~ _s_opt ~ output_type)? ~ nl ~
    (i1 ~ statement ~ nl)+
}

// --- flow declaration ---
flow_decl = {
    "flow" ~ _s ~ ident ~ nl ~
    (i1 ~ needs_clause ~ nl)? ~
    (i1 ~ gives_clause ~ nl)? ~
    (blank_line | stage_block)+
}

stage_block = {
    i1 ~ "stage" ~ _s ~ ident ~ nl ~
    (i2 ~ "needs" ~ _s ~ needs_ref_list ~ nl)? ~
    (blank_line | i2 ~ statement ~ nl)+
}

needs_ref_list = { needs_ref ~ (_s_opt ~ "," ~ _s_opt ~ needs_ref)* }
needs_ref      = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* ~ "." ~ ("*" | (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*) }

// --- agent declaration ---
agent_decl = {
    ("exportable" ~ _s)? ~ "agent" ~ _s ~ ident ~ nl ~
    (i1 ~ lifecycle_clause ~ nl)? ~
    (i1 ~ memory_block)? ~
    (i1 ~ knowledge_block)? ~
    (i1 ~ timer_field ~ nl)* ~
    (i1 ~ schedule_block)* ~
    (i1 ~ correlate_block)* ~
    (i1 ~ webhook_block)* ~
    (i1 ~ subscribe_line ~ nl)* ~
    (i1 ~ warden_override_block)? ~
    (blank_line | on_handler)+ ~
    (i1 ~ stuck_policy)?
}

lifecycle_clause = { "lifecycle" ~ _s_opt ~ ":" ~ _s_opt ~ ident }

memory_block = {
    "memory" ~ (_s ~ "persistent")? ~ nl ~
    (i2 ~ ident ~ _s_opt ~ ":" ~ _s_opt ~ type_name ~ nl)+
}

knowledge_block = {
    "knowledge" ~ _s ~ "store" ~ _s_opt ~ ":" ~ _s_opt ~ template_string ~ nl ~
    (i2 ~ knowledge_option ~ nl)*
}
knowledge_option = {
    "max_entries" ~ _s_opt ~ ":" ~ _s_opt ~ number_lit
  | "retention" ~ _s_opt ~ ":" ~ _s_opt ~ duration
  | "import" ~ _s_opt ~ ":" ~ _s_opt ~ ident_list
  | knowledge_project_id
}
// Per-repo store scoping (#359 / T8.4). Value is any expression so T8.5 can
// inject `memory.repo_slug` from clone-dev config; for T8.4 itself only
// literal Text values are honoured at config-extraction time.
knowledge_project_id = { "project_id" ~ _s_opt ~ ":" ~ _s_opt ~ expr }

timer_field = { "timer" ~ _s ~ ident ~ _s_opt ~ ":" ~ _s_opt ~ duration }

// --- Schedule block ---
// Durable, cross-session wall-clock triggers (distinct from agent-local `timer`).
// Declared under an agent; runtime wiring lands in #332.
schedule_block = {
    "schedule" ~ _s ~ ident ~ nl ~
    (i2 ~ schedule_option ~ nl)+
}
schedule_option = {
      schedule_when
    | schedule_mode
    | schedule_prompt
    | schedule_emit
    | schedule_precision
}
schedule_when = {
    "when" ~ _s_opt ~ ":" ~ _s_opt ~
    ( schedule_when_daily
    | schedule_when_every
    | schedule_when_cron )
}
schedule_when_daily = { "daily" ~ _s ~ "at" ~ _s ~ time_literal }
schedule_when_every = { "every" ~ _s ~ duration }
schedule_when_cron  = { "cron" ~ _s ~ cron_string }

schedule_mode      = { "mode" ~ _s_opt ~ ":" ~ _s_opt ~ schedule_mode_value }
schedule_mode_value = @{ ("spawn" | "wake") ~ !(ASCII_ALPHANUMERIC | "_") }
schedule_prompt    = { "prompt" ~ _s_opt ~ ":" ~ _s_opt ~ template_string }
schedule_emit      = { "emit" ~ _s_opt ~ ":" ~ _s_opt ~ ident }
schedule_precision = { "precision" ~ _s_opt ~ ":" ~ _s_opt ~ schedule_precision_value }
schedule_precision_value = @{ "high" ~ !(ASCII_ALPHANUMERIC | "_") }

time_literal = @{ "\"" ~ ASCII_DIGIT{1,2} ~ ":" ~ ASCII_DIGIT{2} ~ "\"" }
cron_string  = @{ "\"" ~ (!("\"" | NEWLINE) ~ ANY)+ ~ "\"" }

// --- Correlate block ---
// Durable event-to-session routing: inbound events matching a persisted
// correlation key rehydrate the owning specialist instead of spawning fresh.
// Peer driver to `schedule_block`; runtime wiring in #334.
correlate_block = {
    "correlate" ~ _s ~ "on" ~ _s ~ ident ~ "." ~ ident ~ nl ~
    (i2 ~ correlate_option ~ nl)+
}
correlate_option = {
      correlate_mode
    | correlate_emit
}
correlate_mode      = { "mode" ~ _s_opt ~ ":" ~ _s_opt ~ correlate_mode_value }
correlate_mode_value = @{ ("wake" | "spawn") ~ !(ASCII_ALPHANUMERIC | "_") }
correlate_emit      = { "emit" ~ _s_opt ~ ":" ~ _s_opt ~ ident }

// --- Webhook block ---
// HMAC-verified inbound HTTP trigger — third driver on WakeService after
// `schedule_block` (tick) and `correlate_block` (event). Ships cross-project
// handoff (#300). Registered secrets live in the `FORGE_WAKE_SECRETS` redb
// table via the `forge wake` CLI. Runtime wiring in #335.
webhook_block = {
    "webhook" ~ _s ~ ident ~ nl ~
    (i2 ~ webhook_option ~ nl)+
}
webhook_option = {
      webhook_mode
    | webhook_emit
}
webhook_mode      = { "mode" ~ _s_opt ~ ":" ~ _s_opt ~ webhook_mode_value }
webhook_mode_value = @{ ("wake" | "spawn") ~ !(ASCII_ALPHANUMERIC | "_") }
webhook_emit      = { "emit" ~ _s_opt ~ ":" ~ _s_opt ~ ident }

subscribe_line = { "subscribe" ~ _s ~ ident ~ (_s ~ "where" ~ _s ~ expr)? }

on_handler = {
    i1 ~ "on" ~ _s ~ handler_event_name ~
    (_s_opt ~ "(" ~ _s_opt ~ param_list? ~ _s_opt ~ ")")? ~
    (_s_opt ~ ":" ~ _s_opt ~ type_name)? ~
    nl ~
    (i2 ~ requires_clause ~ nl)* ~
    (i2 ~ statement ~ nl)+
}

// Supports dotted names like reconnect_window.expired
handler_event_name = @{
    (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* ~
    ("." ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*)*
}

requires_clause = {
    "requires" ~ _s ~ expr ~
    (_s_opt ~ "on" ~ _s ~ "fail" ~ _s_opt ~ ":" ~ _s_opt ~ fail_policy)?
}

fail_policy = {
    "silent" | "log" | "escalate" | "crash" | "give" ~ _s ~ expr
}

stuck_policy = {
    "if" ~ _s ~ "stuck" ~ (_s ~ "for" ~ _s ~ number_lit ~ _s ~ "turns")? ~ nl ~
    (i2 ~ statement ~ nl)+
}

// --- pool declaration ---
pool_decl = {
    "pool" ~ _s ~ ident ~ nl ~
    i1 ~ "workers" ~ _s_opt ~ ":" ~ _s_opt ~ ident ~ _s ~ "*" ~ _s ~ number_lit ~ nl ~
    i1 ~ "strategy" ~ _s_opt ~ ":" ~ _s_opt ~ pool_strategy ~ nl ~
    (i1 ~ "timeout" ~ _s_opt ~ ":" ~ _s_opt ~ duration ~ nl)? ~
    (i1 ~ "fallback" ~ _s_opt ~ ":" ~ _s_opt ~ ident ~ nl)?
}

pool_strategy = {
    "fastest" | "all" | "majority"
  | "quorum(" ~ _s_opt ~ number_lit ~ _s_opt ~ ")"
  | "first(" ~ _s_opt ~ number_lit ~ _s_opt ~ ")"
}
duration = @{ ASCII_DIGIT+ ~ ("min" | "s" | "m" | "h" | "d") }

// --- warden declaration ---
warden_decl = {
    "warden" ~ _s ~ ident ~ nl ~
    i1 ~ manages_clause ~ nl ~
    (blank_line | i1 ~ ward_policy ~ nl)* ~
    (i1 ~ max_retries_clause ~ nl)?
}

manages_clause = { "manages" ~ _s_opt ~ "[" ~ _s_opt ~ ident_list ~ _s_opt ~ "]" }
ident_list     = { ident ~ (_s_opt ~ "," ~ _s_opt ~ ident)* }

ward_policy = {
    "on" ~ _s ~ failure_type ~ _s_opt ~ ":" ~ _s_opt ~ ward_response ~ _s_opt ~ "," ~ _s_opt ~ ward_scope ~
    (nl ~ i2 ~ after_clause)*
}

failure_type = @{ ("stuck" | "crash" | "hallucination" | "contradiction" | "budget" | "timeout") ~ !(ASCII_ALPHANUMERIC | "_") }

ward_response = @{ ("nudge" | "downgrade" | "restart" | "replace" | "escalate") ~ !(ASCII_ALPHANUMERIC | "_") }

ward_scope = @{ ("self" | "downstream" | "all") ~ !(ASCII_ALPHANUMERIC | "_") }

after_clause = { "after" ~ _s ~ number_lit ~ _s_opt ~ ":" ~ _s_opt ~ ward_response }

max_retries_clause = {
    "max_retries" ~ _s ~ number_lit ~ _s ~ "per" ~ _s ~ duration ~ _s ~ "then" ~ _s ~ "escalate"
}

// --- warden_override block inside agent declarations ---
warden_override_block = {
    "warden_override" ~ nl ~
    (i2 ~ ward_policy ~ nl)*
}

// --- contract declaration ---
contract_decl = {
    "contract" ~ _s ~ ident ~ nl ~
    (i1 ~ can_signature ~ nl)+
}

can_signature = {
    "can" ~ _s ~ ident ~ _s_opt ~ "(" ~ _s_opt ~ param_list? ~ _s_opt ~ ")"
    ~ _s_opt ~ "->" ~ _s_opt ~ type_name
}

// --- system declaration ---
system_decl = {
    "system" ~ _s ~ ident ~ nl ~
    (i1 ~ "use" ~ nl ~ (i2 ~ ident ~ _s_opt ~ ":" ~ _s_opt ~ ident ~ nl)+)? ~
    (blank_line | i1 ~ compose_expr ~ nl)*
}

// --- fn main ---
fn_main_decl = {
    "fn" ~ _s ~ "main" ~ nl ~
    (i1 ~ statement ~ nl)*
}

// --- Statements (i2 level, inside do blocks) ---
statement = {
    when_block
  | match_stmt
  | if_else_stmt
  | for_loop
  | give_stmt
  | say_stmt
  | emit_stmt
  | learn_stmt
  | transition_stmt
  | start_timer_stmt
  | cancel_timer_stmt
  | reset_timer_stmt
  | forward_stmt
  | escalate_stmt
  | memory_update_stmt
  | spawn_stmt
  | retire_stmt
  | bind_stmt
  | expr_stmt
}

bind_stmt          = { ident ~ _s_opt ~ "=" ~ _s_opt ~ expr }
give_stmt          = { "give" ~ _s ~ expr ~ (_s ~ "with" ~ _s ~ give_meta_list)? }
give_meta_list     = { give_meta ~ (_s_opt ~ "," ~ _s_opt ~ give_meta)* }
give_meta          = { ident ~ _s_opt ~ ":" ~ _s_opt ~ expr }
say_stmt           = { "say" ~ _s ~ expr }
escalate_stmt      = { "escalate" ~ _s ~ "to" ~ _s ~ ident }
memory_update_stmt = { "memory" ~ "." ~ ident ~ (_s_opt ~ "[" ~ _s_opt ~ expr ~ _s_opt ~ "]")? ~ _s_opt ~ "=" ~ _s_opt ~ expr }
expr_stmt          = { expr }

emit_stmt          = { "emit" ~ _s ~ ident ~ "(" ~ _s_opt ~ arg_list? ~ _s_opt ~ ")" }
transition_stmt    = { "transition" ~ _s ~ "to" ~ _s ~ ident }
start_timer_stmt   = { "start" ~ _s ~ ident ~ (_s ~ "for" ~ _s ~ expr)? }
cancel_timer_stmt  = { "cancel" ~ _s ~ ident ~ (_s ~ "for" ~ _s ~ expr)? }
reset_timer_stmt   = { "reset" ~ _s ~ ident }
forward_stmt       = { "forward" ~ _s ~ expr ~ _s ~ "to" ~ _s ~ expr }

learn_stmt         = { "learn" ~ _s ~ (learn_from_interaction | learn_from_document | learn_direct) ~ category_clause? }
learn_from_interaction = { "from" ~ _s ~ "interaction" ~ _s_opt ~ "(" ~ _s_opt ~ arg_list ~ _s_opt ~ ")" }
learn_from_document    = { "from" ~ _s ~ "document" ~ _s_opt ~ "(" ~ _s_opt ~ string_arg ~ _s_opt ~ ")" }
learn_direct           = { string_arg }
category_clause        = { _s ~ "category" ~ _s_opt ~ ":" ~ _s_opt ~ string_arg }

// --- spawn statement (create agent instances at runtime, issue #83) ---
spawn_stmt = {
    (ident ~ _s_opt ~ "=" ~ _s_opt)? ~
    "spawn" ~ _s ~ ident ~ (_s ~ "as" ~ _s ~ string_arg)? ~
    (nl ~ i3 ~ spawn_option)*
}
spawn_stmt_i3 = {
    (ident ~ _s_opt ~ "=" ~ _s_opt)? ~
    "spawn" ~ _s ~ ident ~ (_s ~ "as" ~ _s ~ string_arg)? ~
    (nl ~ i4 ~ spawn_option)*
}
spawn_option = {
    spawn_isolate_option | spawn_knowledge_option | spawn_confidence_cap_option | spawn_memory_option
}
spawn_isolate_option        = { "isolate" ~ _s ~ "worktree" ~ _s ~ string_arg }
spawn_knowledge_option      = { "with" ~ _s ~ "knowledge" ~ _s ~ "where" ~ _s ~ spawn_knowledge_pred }
spawn_knowledge_pred        = { "category" ~ _s_opt ~ "==" ~ _s_opt ~ string_arg }
spawn_confidence_cap_option = { "with" ~ _s ~ "confidence_cap" ~ _s_opt ~ ":" ~ _s_opt ~ expr }
spawn_memory_option         = { "with" ~ _s ~ "memory" ~ _s ~ ident ~ _s_opt ~ ":" ~ _s_opt ~ expr }

// --- retire statement (graceful agent termination, issue #86) ---
retire_stmt = {
    "retire" ~ (_s ~ string_arg)? ~ (nl ~ i3 ~ retire_option)*
}
retire_stmt_i3 = {
    "retire" ~ (_s ~ string_arg)? ~ (nl ~ i4 ~ retire_option)*
}
retire_option = {
    retire_knowledge_export
}
retire_knowledge_export = { "with" ~ _s ~ "knowledge" ~ _s ~ "export" ~ _s_opt ~ ":" ~ _s_opt ~ string_arg }

// --- when block (confidence-only branching) ---
when_block = {
    when_clause ~
    (same_indent_when ~ when_clause)* ~
    (same_indent_else ~ else_clause)?
}

// These rules match the indentation for subsequent when/else lines.
// Inside a do_block (i2 indent), subsequent when/else appear at i2.
same_indent_when = _{ nl ~ i2 }
same_indent_else = _{ nl ~ i2 }

when_clause = { "when" ~ _s ~ conf_predicate ~ _s_opt ~ "->" ~ _s_opt ~ statement_inline }
else_clause = { "else" ~ _s_opt ~ "->" ~ _s_opt ~ statement_inline }

statement_inline = {
    give_stmt | say_stmt | escalate_stmt
  | emit_stmt | learn_stmt | transition_stmt
  | start_timer_stmt | cancel_timer_stmt | reset_timer_stmt
  | forward_stmt | retire_stmt | expr_stmt
}

// --- match statement (structural pattern matching) ---
// Does NOT consume trailing nl — caller (do_block) handles it.
match_stmt = {
    "match" ~ _s ~ expr ~ nl ~
    i3 ~ match_arm ~ (nl ~ i3 ~ match_arm)*
}

match_arm = { pattern ~ _s_opt ~ "->" ~ _s_opt ~ statement_inline }

// Patterns: wildcard (_), constructor (Uppercase with optional args), binding (lowercase)
pattern = { wildcard_pattern | constructor_pattern | binding_pattern }
wildcard_pattern    = { "_" }
constructor_pattern = {
    ASCII_ALPHA_UPPER ~ (ASCII_ALPHANUMERIC | "_")* ~
    ("(" ~ _s_opt ~ (pattern ~ (_s_opt ~ "," ~ _s_opt ~ pattern)*)? ~ _s_opt ~ ")")?
}
binding_pattern     = @{ !keyword ~ ASCII_ALPHA_LOWER ~ (ASCII_ALPHANUMERIC | "_")* }

// --- if/else statement (boolean conditions) ---
// Does NOT consume trailing nl — caller (do_block) handles it.
if_else_stmt = {
    "if" ~ _s ~ expr ~ nl ~
    i3 ~ statement_i3 ~ (nl ~ i3 ~ statement_i3)* ~
    (nl ~ i2 ~ "else" ~ _s ~ "if" ~ _s ~ expr ~ nl ~
     i3 ~ statement_i3 ~ (nl ~ i3 ~ statement_i3)*)* ~
    (nl ~ i2 ~ "else" ~ nl ~
     i3 ~ statement_i3 ~ (nl ~ i3 ~ statement_i3)*)?
}

// --- for loop ---
// Does NOT consume trailing nl — caller (do_block) handles it.
for_loop = {
    "for" ~ _s ~ ident ~ _s ~ "in" ~ _s ~ expr ~ nl ~
    i3 ~ statement_i3 ~ (nl ~ i3 ~ statement_i3)*
}

// --- Statements at i3 level (inside if/for/match blocks) ---
// These can nest one more level (bodies at i4) but no deeper.
statement_i3 = {
    when_block_i3
  | match_stmt_i3
  | if_else_stmt_i3
  | for_loop_i3
  | give_stmt
  | say_stmt
  | emit_stmt
  | learn_stmt
  | transition_stmt
  | start_timer_stmt
  | cancel_timer_stmt
  | reset_timer_stmt
  | forward_stmt
  | escalate_stmt
  | memory_update_stmt
  | spawn_stmt_i3
  | retire_stmt_i3
  | bind_stmt
  | expr_stmt
}

when_block_i3 = {
    when_clause_i3 ~
    (nl ~ i3 ~ when_clause_i3)* ~
    (nl ~ i3 ~ else_clause)?
}
when_clause_i3 = { "when" ~ _s ~ conf_predicate ~ _s_opt ~ "->" ~ _s_opt ~ statement_inline }

match_stmt_i3 = {
    "match" ~ _s ~ expr ~ nl ~
    i4 ~ match_arm ~ (nl ~ i4 ~ match_arm)*
}

if_else_stmt_i3 = {
    "if" ~ _s ~ expr ~ nl ~
    i4 ~ statement_i4 ~ (nl ~ i4 ~ statement_i4)* ~
    (nl ~ i3 ~ "else" ~ _s ~ "if" ~ _s ~ expr ~ nl ~
     i4 ~ statement_i4 ~ (nl ~ i4 ~ statement_i4)*)* ~
    (nl ~ i3 ~ "else" ~ nl ~
     i4 ~ statement_i4 ~ (nl ~ i4 ~ statement_i4)*)?
}

for_loop_i3 = {
    "for" ~ _s ~ ident ~ _s ~ "in" ~ _s ~ expr ~ nl ~
    i4 ~ statement_i4 ~ (nl ~ i4 ~ statement_i4)*
}

// --- Statements at i4 level (leaf — no further nesting) ---
statement_i4 = {
    give_stmt
  | say_stmt
  | emit_stmt
  | learn_stmt
  | transition_stmt
  | start_timer_stmt
  | cancel_timer_stmt
  | reset_timer_stmt
  | forward_stmt
  | escalate_stmt
  | memory_update_stmt
  | bind_stmt
  | expr_stmt
}

// --- Confidence predicates ---
conf_predicate = {
    ident ~ "." ~ "sure" ~ "(" ~ _s_opt ~ "above" ~ _s_opt ~ ":" ~ _s_opt ~ number_lit ~ _s_opt ~ ")"
  | ident ~ "." ~ conf_level
}
conf_level = @{ ("sure" | "unsure" | "unreliable" | "conflicted") ~ !(ASCII_ALPHANUMERIC | "_") }

// --- Expressions ---
// Precedence (lowest to highest):
//   compose (>>)  →  or  →  and  →  comparison  →  additive  →
//   multiplicative  →  unary  →  fan_out  →  postfix  →  pipe_term  →  atom
expr = { compose_expr }

compose_expr = { or_expr ~ (_s_opt ~ ">>" ~ _s_opt ~ or_expr)* }

or_expr  = { and_expr ~ (_s ~ "or" ~ _s ~ and_expr)* }
and_expr = { comparison_expr ~ (_s ~ "and" ~ _s ~ comparison_expr)* }

comparison_expr = { additive_expr ~ (_s_opt ~ comparison_op ~ _s_opt ~ additive_expr)? }
comparison_op   = { "==" | "!=" | ">=" | "<=" | ">" | "<" }

additive_expr       = { multiplicative_expr ~ (_s_opt ~ additive_op ~ _s_opt ~ multiplicative_expr)* }
additive_op         = { "+" | "-" }
multiplicative_expr = { unary_expr ~ (_s_opt ~ multiplicative_op ~ _s_opt ~ unary_expr)* }
multiplicative_op   = { "*" | "/" }

unary_expr = { unary_op? ~ fan_out_expr }
unary_op   = { "not" ~ _s | "-" }

fan_out_expr = {
    "(" ~ _s_opt ~ postfix_expr ~ (_s_opt ~ "|" ~ _s_opt ~ postfix_expr)+ ~ _s_opt ~ ")"
  | postfix_expr
}

postfix_expr = { pipe_term ~ postfix_op* }
postfix_op   = {
    "[" ~ _s_opt ~ expr ~ _s_opt ~ "]"
  | "." ~ ident ~ "(" ~ _s_opt ~ arg_list? ~ _s_opt ~ ")"
  | "." ~ (ident | "*")
}

pipe_term = {
    command_method_expr
  | command_expr
  | session_method_expr
  | session_expr
  | exec_expr
  | find_expr
  | reason_expr
  | classify_expr
  | search_expr
  | recall_expr
  | try_or_expr
  | constructor_expr
  | call_expr
  | atom
}

// --- find expression (discover agent instances at runtime, issue #84) ---
find_expr = {
    "find" ~ _s ~ "all" ~ _s ~ ident ~ (_s ~ "where" ~ _s ~ "lifecycle" ~ _s_opt ~ "==" ~ _s_opt ~ ident)?
  | "find" ~ _s ~ string_arg
}

exec_expr     = { "exec" ~ _s ~ string_arg }

// --- command expression (issue #160) — modifiers are order-independent ---
command_arg = { array_lit | string_arg }
command_modifier = {
    "in" ~ _s ~ string_arg
  | "timeout" ~ _s ~ duration
  | "background" ~ _s ~ bool_lit
  | "env" ~ _s ~ env_map
}
command_expr = { "command" ~ _s ~ command_arg ~ (_s ~ command_modifier)* }
command_method_name = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
command_method_expr = { "command" ~ "." ~ command_method_name ~ "(" ~ _s_opt ~ arg_list? ~ _s_opt ~ ")" }
session_method_name = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
session_method_expr = { "session" ~ "." ~ session_method_name ~ "(" ~ _s_opt ~ arg_list? ~ _s_opt ~ ")" }
session_expr = { "session" ~ _s ~ string_arg ~ (_s ~ session_modifier)* }
session_modifier = _{
    session_agent_modifier
  | session_prompt_modifier
  | session_tools_modifier
  | session_timeout_modifier
  | session_budget_modifier
  | session_gives_modifier
  | session_hook_modifier
  | session_isolate_modifier
}
session_agent_modifier   = { "agent" ~ _s ~ string_arg }
session_prompt_modifier  = { "prompt" ~ _s ~ string_arg }
session_tools_modifier   = { "tools" ~ _s ~ expr }
session_timeout_modifier = { "timeout" ~ _s ~ duration }
session_budget_modifier  = { "budget" ~ _s ~ expr }
session_gives_modifier   = { "gives" ~ _s ~ "AgentResult" }
session_hook_modifier    = { "on" ~ _s ~ session_hook_kind ~ _s_opt ~ "->" ~ _s_opt ~ session_emit_hook }
session_isolate_modifier = { "isolate" ~ _s ~ "worktree" ~ _s ~ string_arg }
session_hook_kind = { "progress" | "complete" }
session_emit_hook = { "emit" ~ _s ~ ident ~ "(" ~ _s_opt ~ arg_list? ~ _s_opt ~ ")" }
env_map      = { "{" ~ _s_opt ~ env_entry ~ (_s_opt ~ "," ~ _s_opt ~ env_entry)* ~ _s_opt ~ "}" }
env_entry    = { ident ~ _s_opt ~ ":" ~ _s_opt ~ expr }
// `for <phase>` clause (issue #361, T8.6) — optional trailing tag attaching a
// routing phase key to a `reason`/`classify` call-site. Phase names like
// `classify` collide with the `keyword` exclusion that gates `ident`, so we
// admit a permissive identifier shape here. The position after `for` inside
// `reason_expr`/`classify_expr` is unambiguous, so allowing keywords carries
// no parser conflict.
phase_ident   = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
phase_clause  = { "for" ~ _s ~ phase_ident }
reason_expr   = { "reason" ~ _s ~ string_arg ~ (_s ~ phase_clause)? }
classify_expr = { "classify" ~ _s ~ atom ~ _s ~ "into" ~ _s ~ label_list ~ (_s ~ phase_clause)? }
search_expr   = { "search" ~ _s ~ string_arg }
recall_expr   = { "recall" ~ _s ~ string_arg }
try_or_expr   = { "try" ~ _s ~ and_expr ~ _s ~ "or" ~ _s ~ expr }

string_arg = { template_string | ident }

label_list = { "[" ~ _s_opt ~ template_string
               ~ (_s_opt ~ "," ~ _s_opt ~ template_string)* ~ _s_opt ~ "]" }

constructor_expr = { builtin_type ~ "(" ~ _s_opt ~ arg_list? ~ _s_opt ~ ")" }

call_expr = { ident ~ "(" ~ _s_opt ~ arg_list? ~ _s_opt ~ ")" }
arg_list  = { call_arg ~ (_s_opt ~ "," ~ _s_opt ~ call_arg)* }
call_arg  = { (ident ~ _s_opt ~ ":" ~ _s_opt)? ~ expr }

atom = {
    template_string
  | number_lit
  | bool_lit
  | array_lit
  | type_dot_access
  | ident
  | "(" ~ _s_opt ~ expr ~ _s_opt ~ ")"
}

array_lit = { "[" ~ _s_opt ~ (expr ~ (_s_opt ~ "," ~ _s_opt ~ expr)*)? ~ _s_opt ~ "]" }

// For Intent.unknown, Conversation.empty, etc.
type_dot_access = { builtin_type ~ "." ~ ident }

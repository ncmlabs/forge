task count_files
  gives Text
  do
    run = command ["sh", "-c", "printf '3 files'"] in "." timeout 30s
    if run.success
      when run.sure -> give "count={run.stdout}"
      else -> give "count=unknown"
    else
      when run.sure -> give "count failed"
      else -> give "count failed"

task analyze
  needs count: Text
  gives Text
  do
    report = reason "Analyze a repository with {count}."
    when report.sure -> give report
    else -> give "no analysis"

fn main
  count = count_files()
  say count
  say analyze(count)

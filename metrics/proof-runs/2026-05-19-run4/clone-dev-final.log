eDocument();\n  });\n\n  it('maintains stable layout', () => {\n    const { container } = render(<EmptyState />);\n    const emptyDiv = container.querySelector('.empty-state');\n    expect(emptyDiv).toHaveStyle({ minHeight: '200px' });\n  });\n});\nEOF\n\ncat > src/components/__tests__/Dashboard.test.tsx << 'EOF'\nimport React from 'react';\nimport { render, screen, waitFor } from '@testing-library/react';\nimport { Dashboard } from '../Dashboard';\n\nglobal.fetch = jest.fn();\n\ndescribe('Dashboard', () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n  });\n\n  it('shows loading state initially', () => {\n    (global.fetch as jest.Mock).mockImplementation(() => \n      new Promise(() => {}) // Never resolves\n    );\n    render(<Dashboard />);\n    expect(screen.getByText('Loading dashboard...')).toBeInTheDocument();\n  });\n\n  it('shows error state when API fails', async () => {\n    (global.fetch as jest.Mock).mockRejectedValue(new Error('API Error'));\n    render(<Dashboard />);\n    \n    await waitFor(() => {\n      expect(screen.getByText(/Unable to connect to the API server/)).toBeInTheDocument();\n    });\n  });\n\n  it('shows empty state when no tasks', async () => {\n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => ({ tasks: [], summary: {} })\n    });\n    \n    render(<Dashboard />);\n    \n    await waitFor(() => {\n      expect(screen.getByText('No tasks found')).toBeInTheDocument();\n    });\n  });\n\n  it('shows task table when tasks exist', async () => {\n    const mockTasks = [\n      { id: '1', name: 'Task 1', status: 'running' },\n      { id: '2', name: 'Task 2', status: 'completed' }\n    ];\n    \n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => ({ tasks: mockTasks, summary: {} })\n    });\n    \n    render(<Dashboard />);\n    \n    await waitFor(() => {\n      expect(screen.queryByText('No tasks found')).not.toBeInTheDocument();\n    });\n  });\n\n  it('maintains existing behavior when data exists', async () => {\n    const mockData = {\n      tasks: [{ id: '1', name: 'Task 1', status: 'running' }],\n      summary: { total: 1, running: 1 }\n    };\n    \n    (global.fetch as jest.Mock).mockResolvedValue({\n      ok: true,\n      json: async () => mockData\n    });\n    \n    render(<Dashboard />);\n    \n    await waitFor(() => {\n      expect(screen.getByText('Dashboard')).toBeInTheDocument();\n    });\n  });\n});\nEOF\n\n# Create snapshot tests\ncat > src/components/states/__tests__/StateSnapshots.test.tsx << 'EOF'\nimport React from 'react';\nimport renderer from 'react-test-renderer';\nimport { LoadingState } from '../LoadingState';\nimport { ErrorState } from '../ErrorState';\nimport { EmptyState } from '../EmptyState';\n\ndescribe('State Component Snapshots', () => {\n  it('LoadingState matches snapshot', () => {\n    const tree = renderer.create(<LoadingState />).toJSON();\n    expect(tree).toMatchSnapshot();\n  });\n\n  it('ErrorState matches snapshot', () => {\n    const tree = renderer.create(<ErrorState />).toJSON();\n    expect(tree).toMatchSnapshot();\n  });\n\n  it('ErrorState with retry matches snapshot', () => {\n    const tree = renderer.create(<ErrorState onRetry={() => {}} />).toJSON();\n    expect(tree).toMatchSnapshot();\n  });\n\n  it('EmptyState matches snapshot', () => {\n    const tree = renderer.create(<EmptyState />).toJSON();\n    expect(tree).toMatchSnapshot();\n  });\n});\nEOF\n\n# Ensure TaskTable and RunSummary exist (stub if needed)\nmkdir -p src/components\n\ncat > src/components/TaskTable.tsx << 'EOF'\nimport React from 'react';\n\ninterface Task {\n  id: string;\n  name: string;\n  status: string;\n  [key: string]: any;\n}\n\ninterface TaskTableProps {\n  tasks: Task[];\n}\n\nexport const TaskTable: React.FC<Task","duration_ms":33,"event":"command_return","success":true,"ts_ms":98845}

use
  skill.greeter.hello

states GreetingPhase
  idle -> greeting
  greeting -> idle

agent greeter
  lifecycle: GreetingPhase

  on start(who: Text)
    requires lifecycle == idle on fail: silent
    greeting = skill.greeter.hello(who)
    when greeting.sure -> say greeting
    else -> say "greeting uncertain"
    transition to greeting

fn main
  say "greeter ready"

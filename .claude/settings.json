{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash scripts/check-principles.sh",
            "timeout": 10,
            "statusMessage": "Checking FORGE principles..."
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash scripts/check-security.sh",
            "timeout": 10,
            "statusMessage": "Scanning for secrets..."
          }
        ]
      }
    ]
  }
}
